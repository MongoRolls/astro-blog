---
import type { Props as HeadProps } from '../components/BaseHead.astro'
import type { Locale } from '../i18n/config'
import { ClientRouter } from 'astro:transitions'
import BaseHead from '../components/BaseHead.astro'
import CodeBlockCopy from '../components/CodeBlockCopy.astro'
import Footer from '../components/Footer.astro'
import Nav from '../components/Nav.astro'
import ReadingProgress from '../components/ReadingProgress.astro'
import TableOfContents from '../components/TableOfContents.astro'
import { alternateLocale, defaultLocale, getDefaultAlternates, localizedPath, stripLocalePrefix } from '../i18n/config'

interface Heading {
  depth: number
  slug: string
  text: string
}

export type Props = HeadProps & { headings?: Heading[], languageFallbackPath?: string }
const { headings = [], languageFallbackPath, ...head } = Astro.props
const locale: Locale = head.locale ?? defaultLocale
const alternateUrls = head.alternateUrls ?? getDefaultAlternates(Astro.url.pathname)
const targetLocale = alternateLocale(locale)
const exactAlternateUrl = alternateUrls[targetLocale]
const languageUrl = exactAlternateUrl
  ?? localizedPath(targetLocale, languageFallbackPath ?? stripLocalePrefix(Astro.url.pathname))
const normalizedPath = stripLocalePrefix(Astro.url.pathname)
const isBlogPostPath = /^\/blog\/[^/]+\/?$/.test(normalizedPath)
const hasTableOfContents = isBlogPostPath
  && head.pageType === 'article'
  && headings.some(({ depth }) => depth === 2 || depth === 3)
// https://flocto.github.io/
---

<!doctype html>
<html lang={locale} class="antialiased break-words">
    <head>
        <BaseHead {...head} locale={locale} alternateUrls={alternateUrls} />
        <script is:inline>
        // 初始化主题 - 确保首次渲染与 Astro ClientRouter 软导航切换前后均保持一致，避免闪烁或掉回浅色
        (() => {
          const resolveDark = () => {
            try {
              const savedTheme = localStorage.getItem('theme')
              if (savedTheme === 'dark')
                return true
              if (savedTheme === 'light')
                return false
            }
            catch {}
            return Boolean(window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches)
          }

          const applyTheme = (doc = document) => {
            doc.documentElement.classList.toggle('dark', resolveDark())
          }

          applyTheme()

          if (!window.__blogThemeSwapBound) {
            window.__blogThemeSwapBound = true
            document.addEventListener('astro:before-swap', (event) => {
              if (event.newDocument)
                applyTheme(event.newDocument)
            })
          }
        })()
        </script>
        <ClientRouter />
    </head>
    <body class="bg-main text-main relative">
        <div class="flex flex-col min-h-screen pt-28 md:pt-36">
            <Nav locale={locale} languageUrl={languageUrl} exactLanguageMatch={Boolean(exactAlternateUrl)} />
            <!-- 正常框架 -->
            <main class:list={['flex justify-between w-full max-w-[1012px] max-md:px-5 mx-auto z-0', { 'xl:max-w-[1170px]': hasTableOfContents }]}>
                <div class:list={['hidden lg:block w-40 shrink-0', { 'xl:w-[248px]': hasTableOfContents }]}></div>
                <div class="w-full min-w-0 max-w-[var(--content-width)] mx-auto">
                    <slot />
                </div>
                <div class:list={['hidden lg:block w-40 shrink-0 relative', { 'xl:w-[248px]': hasTableOfContents }]}>
                    {hasTableOfContents && <TableOfContents headings={headings} locale={locale} />}
                </div>
            </main>
            <Footer locale={locale} />
        </div>
        <ReadingProgress locale={locale} />
        <CodeBlockCopy locale={locale} />
    </body>
</html>
