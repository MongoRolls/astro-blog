---
import type { Locale } from '../i18n/config'
import { getPostCoverSrc } from '../config/image'
import { defaultLocale } from '../i18n/config'
import BaseLayout from '../layouts/BaseLayout.astro'

type Props = { locale?: Locale }
const { locale = defaultLocale } = Astro.props
const copy = {
    'zh-CN': {
        title: '项目',
        description: '聚合简报、博客、资讯与收藏，让阅读更专注。',
        visit: '打开阅读站',
        newTab: '（在新标签页打开）',
        coverAlt: '陶土橙色的芒果由奶白书页折成，悬浮在炭黑书签上，周围漂着纸质消息卡片。',
    },
    'en': {
        title: 'Projects',
        description: 'Briefings, blogs, news, and bookmarks in one quiet reading space.',
        visit: 'Visit site',
        newTab: '(opens in a new tab)',
        coverAlt: 'A terracotta mango made of ivory book pages floats above a charcoal bookmark, surrounded by folded paper message cards.',
    },
}[locale]
const cover = {
    src: getPostCoverSrc({ image: '/cover-images/mango-reader.webp' }),
    alt: copy.coverAlt,
}
---

<BaseLayout title={copy.title} description={`Mango Reader — ${copy.description}`} image={cover} locale={locale}>
    <section aria-labelledby="projects-title">
        <h1 id="projects-title" class="text-xl leading-tight font-serif font-medium sm:text-2xl mb-6">{copy.title}</h1>

        <article aria-labelledby="mango-reader-title">
            <a
              href="https://mango-reader.vercel.app/"
              target="_blank"
              rel="noopener noreferrer"
              aria-labelledby="mango-reader-title"
              aria-describedby="mango-reader-description mango-reader-new-tab"
              class="project-card"
            >
                <div class="min-w-0">
                    <h2 id="mango-reader-title" class="project-title">Mango Reader</h2>
                    <p id="mango-reader-description" class="project-description">{copy.description}</p>
                    <span class="project-action">
                        {copy.visit}
                        <span id="mango-reader-new-tab" class="sr-only">{copy.newTab}</span>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M7 17 17 7M7 7h10v10" />
                        </svg>
                    </span>
                </div>
                <img
                  src={getPostCoverSrc({ image: '/cover-images/mango-reader-600.webp' })}
                  alt={cover.alt}
                  width="600"
                  height="315"
                  loading="lazy"
                  decoding="async"
                  class="project-cover"
                />
            </a>
        </article>
    </section>
</BaseLayout>

<style>
    .project-card {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 7rem;
        align-items: center;
        gap: 1.25rem;
        padding: 1rem 1.25rem;
        border: 1px solid rgb(var(--color-border-card));
        border-radius: 0.625rem;
        background: rgb(var(--color-bg-card));
        color: rgb(var(--color-text-main));
        text-decoration: none;
        transition: border-color 0.15s ease;
    }

    .project-cover {
        display: block;
        width: 7rem;
        height: 5.25rem;
        object-fit: cover;
        border-radius: 0.375rem;
    }

    .project-title {
        font-size: 1.25rem;
        font-weight: 500;
        line-height: 1.4;
    }

    .project-description {
        margin-top: 0.375rem;
        font-size: 0.875rem;
        line-height: 1.6;
        color: rgb(var(--color-text-p));
    }

    .project-action {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        margin-top: 0.625rem;
        font-size: 0.8125rem;
        line-height: 1.5;
        color: rgb(var(--color-text-muted));
    }

    .project-card:hover {
        border-color: rgb(var(--color-text-muted));
    }

    .project-card:is(:hover, :focus-visible) .project-title {
        text-decoration: underline;
        text-underline-offset: 0.2em;
    }

    .project-card:focus-visible {
        outline: 2px solid rgb(var(--color-brand));
        outline-offset: 4px;
    }

    @media (max-width: 767px) {
        .project-card {
            grid-template-columns: minmax(0, 1fr) 4.5rem;
            gap: 1rem;
            padding: 1rem;
        }

        .project-cover {
            width: 4.5rem;
            height: 4.5rem;
        }

        .project-title {
            font-size: 1.125rem;
        }
    }
</style>
