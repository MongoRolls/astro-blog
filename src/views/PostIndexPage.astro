---
import type { Locale } from '../i18n/config'
import FormattedDate from '../components/FormattedDate.astro'
import { defaultLocale } from '../i18n/config'
import { useTranslations } from '../i18n/ui'
import BaseLayout from '../layouts/BaseLayout.astro'
import { getPostTagBadges, getPostUrl, getPublishedBlogPosts } from '../utils/data-utils'

type Props = { locale?: Locale }
const { locale = defaultLocale } = Astro.props
const t = useTranslations(locale)
const sortedBlogPosts = await getPublishedBlogPosts(locale)
const title = locale === 'zh-CN' ? '文章列表' : 'All Posts'
---

<BaseLayout
  locale={locale}
  title={title}
  description={locale === 'zh-CN' ? '按时间排列的全部博文，记录知识与思考沿途碰撞的痕迹。' : 'All posts in chronological order, documenting discoveries in technology and thought.'}
>
    <section class="w-full" aria-labelledby="archive-heading">
        <h1 class="sr-only">{title}</h1>

        <header class="section-head section-head--divided archive-head">
            <div class="section-title-row">
                <h2 id="archive-heading" class="section-title font-serif">
                    {locale === 'zh-CN' ? '全部归档' : 'Archive'}
                </h2>
                <span class="section-count">{sortedBlogPosts.length}</span>
            </div>
            <p class="section-desc">
                {locale === 'zh-CN' ? '记录知识与思考沿途碰撞的痕迹' : 'Notes from the intersection of knowledge and thought'}
            </p>
        </header>

        <ul class="archive-list">
        {sortedBlogPosts.map((post) => {
            const postTags = getPostTagBadges(post.data.tags)
            return (
                <li class="archive-item">
                    <span class="archive-bullet" aria-hidden="true"></span>
                    <div class="archive-entry">
                        <a class="archive-title" href={getPostUrl(post)}>{post.data.title}</a>
                        {post.data.draft && <span class="draft-badge archive-draft-badge">{t.post.draft}</span>}
                        {postTags.length > 0 && (
                            <span class="archive-tags">
                                {postTags.map(tag => (
                                    <span class:list={['archive-tag', `archive-tag--tone-${tag.tone}`]}>
                                        {tag.name}
                                    </span>
                                ))}
                            </span>
                        )}
                        <span class="archive-date-wrap"><span class="archive-sep" aria-hidden="true">-</span><span class="archive-date"><FormattedDate format="iso" date={post.data.publishDate} locale={locale} /></span></span>
                    </div>
                </li>
            )
        })}
        </ul>
    </section>
</BaseLayout>

<style>
    .archive-head {
        margin-bottom: 0.9rem;
    }

    .archive-list {
        display: flex;
        flex-direction: column;
        gap: 0.125rem;
        padding: 0;
        list-style: none;
    }

    .archive-item {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        column-gap: 0.65rem;
        align-items: start;
        padding: 0.375rem 0.625rem;
        margin-inline: -0.625rem;
        border-radius: 0.5rem;
        transition: background-color 150ms ease;
    }

    .archive-item:hover {
        background-color: rgb(var(--color-text-main) / 0.035);
    }

    :global(html.dark) .archive-item:hover {
        background-color: rgb(180 190 254 / 0.06);
    }

    .archive-bullet {
        width: 0.34rem;
        height: 0.34rem;
        margin-top: 0.74rem;
        border-radius: 9999px;
        background-color: rgb(var(--color-brand) / 0.52);
        transition: background-color 150ms ease, transform 150ms ease;
    }

    :global(html.dark) .archive-bullet {
        background-color: rgb(var(--color-brand) / 0.65);
    }

    .archive-item:is(:hover, :focus-within) .archive-bullet {
        background-color: rgb(var(--color-brand));
        transform: scale(1.15);
    }

    .archive-entry {
        min-width: 0;
        font-size: 1.02rem;
        line-height: 1.8;
        overflow-wrap: anywhere;
    }

    .archive-item .archive-title {
        color: rgb(var(--color-text-main));
        font-weight: 500;
        text-decoration: none;
        margin-right: 0.25rem;
        transition: color 150ms ease;
    }

    .archive-item .archive-title:hover {
        color: rgb(var(--color-brand));
    }

    .archive-item .archive-title:focus-visible {
        color: rgb(var(--color-brand));
        outline: 2px solid rgb(var(--color-brand));
        outline-offset: 4px;
        border-radius: 2px;
    }

    .archive-tags {
        display: inline;
        margin-right: 0.15rem;
    }

    .archive-draft-badge {
        margin-right: 0.3rem;
    }

    .archive-tag {
        display: inline-block;
        vertical-align: 0.06em;
        margin-right: 0.3rem;
        margin-block: 0.08rem;
        padding: 0.08rem 0.44rem;
        border: 1px solid transparent;
        border-radius: 0.3rem;
        font-size: 0.75rem;
        line-height: 1.45;
        font-weight: 500;
    }

    .archive-tag:last-child {
        margin-right: 0;
    }

    .archive-tag--tone-0 {
        background-color: rgb(59 130 246 / 0.09);
        color: rgb(43 84 156);
    }

    .archive-tag--tone-1 {
        background-color: rgb(16 140 100 / 0.09);
        color: rgb(30 112 85);
    }

    .archive-tag--tone-2 {
        background-color: rgb(219 88 124 / 0.09);
        color: rgb(159 58 88);
    }

    .archive-tag--tone-3 {
        background-color: rgb(124 92 214 / 0.09);
        color: rgb(96 71 170);
    }

    .archive-tag--tone-4 {
        background-color: rgb(107 114 128 / 0.1);
        color: rgb(75 85 99);
    }

    :global(html.dark) .archive-tag--tone-0 {
        background-color: rgb(137 180 250 / 0.13);
        color: rgb(166 202 252);
    }

    :global(html.dark) .archive-tag--tone-1 {
        background-color: rgb(148 226 213 / 0.12);
        color: rgb(166 227 161);
    }

    :global(html.dark) .archive-tag--tone-2 {
        background-color: rgb(243 139 168 / 0.13);
        color: rgb(245 170 192);
    }

    :global(html.dark) .archive-tag--tone-3 {
        background-color: rgb(203 166 247 / 0.13);
        color: rgb(214 186 250);
    }

    :global(html.dark) .archive-tag--tone-4 {
        background-color: rgb(166 173 200 / 0.13);
        color: rgb(186 194 222);
    }

    .archive-date-wrap {
        white-space: nowrap;
        font-size: 0.8125rem;
        font-variant-numeric: tabular-nums;
        color: rgb(var(--color-text-muted));
    }

    .archive-sep {
        margin-right: 0.3rem;
        color: rgb(var(--color-text-muted) / 0.55);
    }

    @media (max-width: 767px) {
        .archive-item {
            padding: 0.45rem 0.5rem;
            margin-inline: -0.5rem;
            column-gap: 0.55rem;
        }

        .archive-bullet {
            margin-top: 0.68rem;
        }

        .archive-entry {
            font-size: 0.97rem;
            line-height: 1.75;
        }
    }
</style>
