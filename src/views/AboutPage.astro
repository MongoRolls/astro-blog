---
import type { Locale } from '../i18n/config'
import MediaCard from '../components/MediaCard.astro'
import { nowUpdates, recentBooks, recentGames } from '../data/about'
import { defaultLocale } from '../i18n/config'
import BaseLayout from '../layouts/BaseLayout.astro'

type Props = { locale?: Locale }
const { locale = defaultLocale } = Astro.props
const title = locale === 'zh-CN' ? '关于' : 'About'
const description = locale === 'zh-CN'
  ? '关于 MongoRolls：前端工程师，关注工程化、开源与个人写作。'
  : 'About MongoRolls, a frontend engineer interested in web tooling, open source, and writing.'

const profileFacts = locale === 'zh-CN'
  ? [
      { emoji: '👋', text: '英文昵称叫 MongoRolls，叫我芒果也行' },
      { emoji: '🔭', text: '在转全干的前端开发工程师' },
      { emoji: '🌱', text: '目前就职于猪场' },
      { emoji: '✨', text: '希望持续参与并贡献开源' },
    ]
  : [
      { emoji: '👋', text: 'I’m MongoRolls, or feel free to call me Mango' },
      { emoji: '🔭', text: 'A frontend engineer going full-stack' },
      { emoji: '🌱', text: 'Currently working at NetEase' },
      { emoji: '✨', text: 'Working toward contributing more to open source' },
    ]

function anchorLabel(sectionName: string) {
  return locale === 'zh-CN' ? `链接到「${sectionName}」` : `Link to ${sectionName}`
}

const sectionTitles = {
  site: locale === 'zh-CN' ? '关于本站' : 'About this site',
  me: locale === 'zh-CN' ? '关于我' : 'About me',
  now: locale === 'zh-CN' ? '近况' : 'Now',
  books: locale === 'zh-CN' ? '最近读过' : 'Recently Read',
  games: locale === 'zh-CN' ? '最近玩过' : 'Recently Played',
}
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
>
  <article data-pagefind-body class="about-page" aria-labelledby="about-page-title">
    <h1 id="about-page-title" class="sr-only" data-pagefind-meta="title">{title}</h1>

    <section class="about-section" aria-labelledby="about-me">
      <h2 id="about-me" class="section-title about-heading font-serif">
        <span>{sectionTitles.me}</span>
        <a class="heading-anchor" href="#about-me" aria-label={anchorLabel(sectionTitles.me)}>#</a>
      </h2>

      <ul class="about-facts">
        {profileFacts.map(fact => (
          <li class="about-fact-item">
            <span class="about-emoji" aria-hidden="true">{fact.emoji}</span>
            <span>{fact.text}</span>
          </li>
        ))}
      </ul>
    </section>

    <hr class="about-divider" />

    <section class="about-section" aria-labelledby="about-me-now">
      <h2 id="about-me-now" class="section-title about-heading font-serif">
        <span>{sectionTitles.now}</span>
        <a class="heading-anchor" href="#about-me-now" aria-label={anchorLabel(sectionTitles.now)}>#</a>
      </h2>

      <ul class="about-now-list">
        {nowUpdates.map(item => (
          <li class="about-now-item">
            <span class="about-emoji" aria-hidden="true">{item.emoji}</span>
            <span>{item.text[locale]}</span>
          </li>
        ))}
      </ul>
    </section>

    <hr class="about-divider" />

    <section class="about-section" aria-labelledby="about-me-books">
      <h2 id="about-me-books" class="section-title about-heading about-heading--media font-serif">
        <span class="about-emoji" aria-hidden="true">📚</span>
        <span>{sectionTitles.books}</span>
        <a class="heading-anchor" href="#about-me-books" aria-label={anchorLabel(sectionTitles.books)}>#</a>
      </h2>

      <div class="media-grid">
        {recentBooks.map(book => (
          <MediaCard
            title={book.title[locale]}
            cover={book.cover}
            coverAlt={book.coverAlt[locale]}
            kind={book.kind}
            rating={book.rating}
            status={book.status?.[locale]}
            note={book.note[locale]}
            href={book.href}
            locale={locale}
          />
        ))}
      </div>
    </section>

    <section class="about-section about-section--media-next" aria-labelledby="about-me-games">
      <h2 id="about-me-games" class="section-title about-heading about-heading--media font-serif">
        <span class="about-emoji" aria-hidden="true">🎮</span>
        <span>{sectionTitles.games}</span>
        <a class="heading-anchor" href="#about-me-games" aria-label={anchorLabel(sectionTitles.games)}>#</a>
      </h2>

      <div class="media-grid">
        {recentGames.map(game => (
          <MediaCard
            title={game.title[locale]}
            cover={game.cover}
            coverAlt={game.coverAlt[locale]}
            kind={game.kind}
            rating={game.rating}
            status={game.status?.[locale]}
            note={game.note[locale]}
            href={game.href}
            locale={locale}
          />
        ))}
      </div>
    </section>

    <hr class="about-divider" />

    <section class="about-section" aria-labelledby="about-site">
      <h2 id="about-site" class="section-title about-heading font-serif">
        <span>{sectionTitles.site}</span>
        <a class="heading-anchor" href="#about-site" aria-label={anchorLabel(sectionTitles.site)}>#</a>
      </h2>

      {locale === 'zh-CN'
? (
        <div class="about-copy">
          <p>
            经过多个方案比较，最终选定了这套技术栈。本站基于 <a class="post-link" href="https://astro.build/" target="_blank" rel="noopener noreferrer"><span class="post-link-text">Astro</span></a> 构建并持续定制。
          </p>
          <p>
            评论区采用 <a class="post-link" href="https://twikoo.js.org/" target="_blank" rel="noopener noreferrer"><span class="post-link-text">Twikoo</span></a>，数据存储于 MongoDB；网站部署在 <a class="post-link" href="https://vercel.com/" target="_blank" rel="noopener noreferrer"><span class="post-link-text">Vercel</span></a>。
          </p>
        </div>
      )
: (
        <div class="about-copy">
          <p>
            After comparing several approaches, I settled on the stack powering this site today. It is built with <a class="post-link" href="https://astro.build/" target="_blank" rel="noopener noreferrer"><span class="post-link-text">Astro</span></a> and continuously customized as it evolves.
          </p>
          <p>
            Comments are powered by <a class="post-link" href="https://twikoo.js.org/" target="_blank" rel="noopener noreferrer"><span class="post-link-text">Twikoo</span></a> with MongoDB storage, and the site is deployed on <a class="post-link" href="https://vercel.com/" target="_blank" rel="noopener noreferrer"><span class="post-link-text">Vercel</span></a>.
          </p>
        </div>
      )}
    </section>

    <hr class="about-divider" />

    <div class="about-meta-grid">
      <section class="about-section" aria-labelledby="about-me-footprint">
        <h3 id="about-me-footprint" class="about-subhead">
          <span class="about-emoji" aria-hidden="true">🗺️</span>
          <span>{locale === 'zh-CN' ? '足迹' : 'Footprints'}</span>
        </h3>
        <p class="about-meta-text">
          {locale === 'zh-CN' ? '工作与生活足迹持续更新中。' : 'Notes from work and life are continually being added.'}
        </p>
      </section>

      <section class="about-section" aria-labelledby="about-me-contact">
        <h3 id="about-me-contact" class="about-subhead">
          <span class="about-emoji" aria-hidden="true">📫</span>
          <span>{locale === 'zh-CN' ? '联系方式' : 'Contact'}</span>
        </h3>
        <p class="about-meta-text">
          GitHub:{' '}
          <a
            class="post-link"
            href="https://github.com/MongoRolls"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="post-link-text">MongoRolls</span>
          </a>
        </p>
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  .about-page {
    width: 100%;
  }

  .about-section {
    scroll-margin-top: 6rem;
  }

  .about-section--media-next {
    margin-top: 1.5rem;
  }

  .about-heading {
    display: inline-flex;
    align-items: baseline;
    gap: 0.38rem;
  }

  .about-heading--media {
    margin-bottom: 0.85rem;
  }

  .heading-anchor {
    font-family: 'Inter', 'Noto Sans SC', sans-serif;
    font-size: 0.88em;
    font-weight: 500;
    line-height: 1;
    color: rgb(var(--color-brand) / 0.72);
    text-decoration: none;
    opacity: 0;
    transform: translateX(-2px);
    transition:
      opacity 160ms ease,
      transform 160ms ease,
      color 150ms ease;
  }

  .about-heading:hover .heading-anchor,
  .about-heading:focus-within .heading-anchor {
    opacity: 1;
    transform: translateX(0);
  }

  .heading-anchor:hover,
  .heading-anchor:focus-visible {
    color: rgb(var(--color-brand));
  }

  .heading-anchor:focus-visible {
    outline: 2px solid rgb(var(--color-brand));
    outline-offset: 2px;
    border-radius: 3px;
  }

  .about-copy {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin-top: 0.75rem;
  }

  .about-copy p {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.75;
    color: rgb(var(--color-text-p));
  }

  .about-facts,
  .about-now-list {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .about-fact-item,
  .about-now-item {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 0.96rem;
    line-height: 1.65;
    color: rgb(var(--color-text-p));
  }

  .about-emoji {
    flex-shrink: 0;
    line-height: 1;
  }

  .about-subhead {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0 0 0.45rem;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
    color: rgb(var(--color-text-main));
  }

  .media-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
  }

  .about-divider {
    margin: 1.75rem 0;
    border: 0;
    border-top: 1px dashed rgb(var(--color-border-card) / 0.8);
  }

  .about-meta-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .about-meta-text {
    margin: 0;
    font-size: 0.94rem;
    line-height: 1.65;
    color: rgb(var(--color-text-p));
  }

  @media (hover: none) {
    .heading-anchor {
      opacity: 0.4;
      transform: none;
    }
  }

  @media (max-width: 639px) {
    .media-grid,
    .about-meta-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .media-grid {
      gap: 0.8rem;
    }

    .about-meta-grid {
      gap: 1rem;
    }

    .about-divider {
      margin: 1.45rem 0;
    }
  }
</style>
