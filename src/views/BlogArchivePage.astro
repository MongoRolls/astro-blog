---
import type { Locale } from '../i18n/config'
import PostPreview from '../components/PostPreview.astro'
import { defaultLocale } from '../i18n/config'
import BaseLayout from '../layouts/BaseLayout.astro'
import { getPublishedBlogPosts } from '../utils/data-utils'

type Props = { locale?: Locale }

const { locale = defaultLocale } = Astro.props
const posts = await getPublishedBlogPosts(locale)
const title = locale === 'zh-CN' ? '博客' : 'Blog'
---

<BaseLayout
  locale={locale}
  languageFallbackPath="/blog/"
  title={title}
  description={locale === 'zh-CN'
    ? 'MongoRolls 的博客文章列表，涵盖前端开发、工程化与个人思考。'
    : 'Frontend engineering, web tooling, AI, and personal notes from MongoRolls.'}
>
    <section class="w-full" aria-labelledby="blog-feed-heading">
        <h1 class="sr-only">{title}</h1>

        <header class="section-head section-head--divided blog-feed-head">
            <div class="section-title-row">
                <h2 id="blog-feed-heading" class="section-title font-serif">
                    {locale === 'zh-CN' ? '图文阅读' : 'Reading Feed'}
                </h2>
                <span class="section-count">{posts.length}</span>
            </div>
            <p class="section-desc">
                {locale === 'zh-CN' ? '按时间倒序，带封面与导读的图文浏览' : 'Full previews with covers and excerpts, newest first'}
            </p>
        </header>

        <div class="flex flex-col">
            {posts.map(post => (
            <PostPreview post={post} locale={locale} headingLevel="h3" />
            ))}
        </div>
    </section>
</BaseLayout>

<style>
    .blog-feed-head {
        margin-bottom: 1.75rem;
    }
</style>
