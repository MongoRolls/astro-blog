---
import type { Locale } from '../i18n/config'
import { defaultLocale, localizedPath } from '../i18n/config'
import { useTranslations } from '../i18n/ui'

type Props = { locale?: Locale }
const { locale = defaultLocale } = Astro.props
const t = useTranslations(locale)
---

<button type="button" class="flex items-center justify-center w-full h-full text-main hover:text-blue-500 cursor-pointer transition-colors duration-200 mr-2" id="search-icon" aria-label={t.search.button}>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6">
    <circle cx="11" cy="11" r="8"></circle>
    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
  </svg>
</button>

<div
  class="hidden"
  id="search-box"
  data-index-url={localizedPath(locale, '/search-index.json')}
  data-loading-message={t.search.loading}
  data-no-results-message={t.search.noResults}
  data-unavailable-message={t.search.unavailable}
  data-result-one={t.search.resultCount(1)}
  data-result-template={t.search.resultCount(123).replace('123', '{count}')}
>
  <div
    id="search-backdrop"
    class="fixed z-[1000] left-0 top-0 backdrop-blur-xl h-screen w-screen overflow-hidden flex justify-center items-start bg-zinc-900/30 dark:bg-zinc-600/30"
  >
  </div>
  <div
    class="fixed left-1/2 top-20 sm:top-32 -translate-x-1/2 z-[1001] w-[calc(100%-2rem)] max-w-[560px] bg-white/95 dark:bg-zinc-800/95 rounded-xl overflow-hidden shadow-xl dark:shadow-2xl backdrop-blur-md transform transition-all duration-300 opacity-0 scale-95 border border-blue-500/30"
    id="search-container"
    role="dialog"
    aria-modal="true"
    aria-label={t.search.dialog}
  >
    <div class="p-4 relative">
      <input
        id="search-input"
        class="w-full p-3 pl-10 border-2 border-blue-500 rounded-lg focus:ring-0 focus:border-blue-500 outline-none bg-white/90 dark:bg-zinc-700/90 dark:text-white"
        type="text"
        placeholder={t.search.placeholder}
        aria-label={t.search.input}
        autocomplete="off"
        autofocus
      />
      <div class="absolute left-6 top-7 text-blue-500">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </div>
      <button
        id="search-close"
        class="absolute right-6 top-1/2 -translate-y-1/2 text-gray-500 hover:text-gray-700 dark:hover:text-gray-300 transition-colors duration-200 bg-white dark:bg-zinc-600 p-2 rounded-full"
        aria-label={t.search.close}
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div id="results" class="min-h-52 max-h-96 p-4 pt-0 overflow-auto space-y-2" aria-live="polite">
      <div class="w-full min-h-48 text-5xl flex justify-center items-center select-none">
        <span>🔍</span>
      </div>
    </div>
  </div>
</div>

<script>
interface SearchResult {
  excerpt: string
  meta: { title: string }
  searchText?: string
  url: string
}

interface Pagefind {
  init: () => Promise<void>
  search: (query: string) => Promise<{
    results: Array<{ data: () => Promise<SearchResult> }>
  }>
}

let disposeSearch = () => {}
let pagefindPromise: Promise<Pagefind> | undefined

async function loadFallbackSearch(indexUrl: string): Promise<Pagefind> {
  const response = await fetch(indexUrl)
  if (!response.ok)
    throw new Error(`搜索索引加载失败: ${response.status}`)
  const items = await response.json() as SearchResult[]

  return {
    init: async () => {},
    search: async (query) => {
      const normalizedQuery = query.toLocaleLowerCase()
      const matches = items.filter(({ excerpt, meta, searchText }) =>
        `${meta.title} ${excerpt} ${searchText ?? ''}`.toLocaleLowerCase().includes(normalizedQuery),
      )
      return {
        results: matches.map(item => ({ data: async () => item })),
      }
    },
  }
}

async function loadPagefindEngine(): Promise<Pagefind> {
  const pagefindUrl = new URL('/pagefind/pagefind.js', window.location.origin).href
  const pagefind = await import(/* @vite-ignore */ pagefindUrl) as Pagefind
  await pagefind.init()
  return pagefind
}

function loadPagefind(indexUrl: string) {
  pagefindPromise ||= loadPagefindEngine().catch((error) => {
    if (import.meta.env.DEV)
      console.warn('Pagefind 不可用，已回退到本地搜索索引。先运行 pnpm build 可启用完整搜索。', error)
    return loadFallbackSearch(indexUrl)
  })
  return pagefindPromise
}

function initSearchFeature() {
  disposeSearch()

  const searchIcon = document.querySelector<HTMLElement>('#search-icon')
  const searchBox = document.querySelector<HTMLElement>('#search-box')
  const searchBackdrop = document.querySelector<HTMLElement>('#search-backdrop')
  const searchContainer = document.querySelector<HTMLElement>('#search-container')
  const searchInput = document.querySelector<HTMLInputElement>('#search-input')
  const searchClose = document.querySelector<HTMLButtonElement>('#search-close')
  const resultsElement = document.querySelector<HTMLElement>('#results')

  if (!searchIcon || !searchBox || !searchContainer || !searchInput || !resultsElement)
    return

  const searchResults = resultsElement
  const input = searchInput
  const indexUrl = searchBox.dataset.indexUrl ?? '/search-index.json'
  const loadingMessage = searchBox.dataset.loadingMessage ?? 'Searching…'
  const noResultsMessage = searchBox.dataset.noResultsMessage ?? 'No results found'
  const unavailableMessage = searchBox.dataset.unavailableMessage ?? 'Search is temporarily unavailable'
  const resultOne = searchBox.dataset.resultOne ?? '1 result found'
  const resultTemplate = searchBox.dataset.resultTemplate ?? '{count} results found'
  const controller = new AbortController()
  const listenerOptions = { signal: controller.signal }
  let previouslyFocused: HTMLElement | null = null
  let closeTimer: number | undefined
  let searchTimer: number | undefined
  let requestId = 0

  function createMessage(text: string, className = 'text-gray-500') {
    const message = document.createElement('div')
    message.className = `w-full min-h-48 flex justify-center items-center ${className}`
    message.textContent = text
    return message
  }

  function renderMessage(text: string, className?: string) {
    searchResults.replaceChildren(createMessage(text, className))
  }

  function createExcerpt(excerpt: string) {
    const paragraph = document.createElement('p')
    paragraph.className = 'text-gray-600 dark:text-gray-300 text-sm line-clamp-2 mt-1 ml-2'
    const parsed = new DOMParser().parseFromString(excerpt, 'text/html')

    function appendSafeNodes(source: Node, target: Node) {
      source.childNodes.forEach((node) => {
        if (node.nodeType === Node.TEXT_NODE) {
          target.appendChild(document.createTextNode(node.textContent ?? ''))
        }
        else if (node instanceof HTMLElement) {
          const nextTarget = node.tagName === 'MARK' ? document.createElement('mark') : target
          if (nextTarget !== target)
            target.appendChild(nextTarget)
          appendSafeNodes(node, nextTarget)
        }
      })
    }

    appendSafeNodes(parsed.body, paragraph)
    return paragraph
  }

  function renderResults(data: SearchResult[]) {
    const fragment = document.createDocumentFragment()
    const count = document.createElement('div')
    count.className = 'text-sm text-gray-500 mb-3 px-1'
    count.textContent = data.length === 1 ? resultOne : resultTemplate.replace('{count}', String(data.length))
    fragment.appendChild(count)

    data.forEach(({ excerpt, meta, url }) => {
      const card = document.createElement('div')
      card.className = 'bg-white dark:bg-zinc-700 p-3 rounded-lg shadow-md border border-gray-100 dark:border-zinc-600'
      const link = document.createElement('a')
      link.href = url
      link.className = 'text-blue-500 hover:text-blue-600 font-medium text-lg'
      link.textContent = meta.title
      card.append(link, createExcerpt(excerpt))
      fragment.appendChild(card)
    })

    searchResults.replaceChildren(fragment)
  }

  function openSearch() {
    previouslyFocused = document.activeElement as HTMLElement | null
    document.querySelector<HTMLButtonElement>('.menu-toggle[aria-expanded="true"]')?.click()
    if (closeTimer)
      window.clearTimeout(closeTimer)
    document.body.style.overflow = 'hidden'
    searchBox?.classList.remove('hidden')
    requestAnimationFrame(() => {
      searchContainer?.classList.remove('opacity-0', 'scale-95')
      searchContainer?.classList.add('opacity-100', 'scale-100')
      input.focus()
    })
  }

  function closeSearch() {
    document.body.style.overflow = ''
    searchContainer?.classList.remove('opacity-100', 'scale-100')
    searchContainer?.classList.add('opacity-0', 'scale-95')
    closeTimer = window.setTimeout(() => searchBox?.classList.add('hidden'), 300)
    previouslyFocused?.focus()
  }

  async function handleSearch(value: string) {
    const currentRequest = ++requestId
    if (!value) {
      renderMessage('🔍', 'text-5xl select-none')
      return
    }

    searchResults.setAttribute('aria-busy', 'true')
    renderMessage(loadingMessage)

    try {
      const pagefind = await loadPagefind(indexUrl)
      const search = await pagefind.search(value)
      const data = await Promise.all(search.results.map(item => item.data()))
      if (currentRequest !== requestId || input.value.trim() !== value)
        return

      if (data.length === 0) {
        renderMessage(noResultsMessage)
        return
      }

      renderResults(data)
    }
    catch (error) {
      console.error('搜索出错:', error)
      if (currentRequest === requestId)
        renderMessage(unavailableMessage, 'text-red-500')
    }
    finally {
      if (currentRequest === requestId)
        searchResults.removeAttribute('aria-busy')
    }
  }

  searchIcon.addEventListener('click', openSearch, listenerOptions)
  searchClose?.addEventListener('click', closeSearch, listenerOptions)
  searchBackdrop?.addEventListener('click', closeSearch, listenerOptions)
  document.addEventListener('blog:open-search', openSearch, listenerOptions)
  document.addEventListener('click', (event) => {
    const target = event.target
    if (target instanceof Element && target.closest('[data-open-search]'))
      openSearch()
  }, listenerOptions)
  input.addEventListener('input', () => {
    if (searchTimer)
      window.clearTimeout(searchTimer)
    const value = input.value.trim()
    if (!value) {
      requestId++
      renderMessage('🔍', 'text-5xl select-none')
      return
    }
    searchTimer = window.setTimeout(() => void handleSearch(value), 250)
  }, listenerOptions)
  document.addEventListener('keydown', (event) => {
    if ((event.ctrlKey || event.metaKey) && event.key === 'k') {
      event.preventDefault()
      openSearch()
    }
    else if (event.key === 'Escape' && !searchBox.classList.contains('hidden')) {
      closeSearch()
    }
    else if (event.key === 'Tab' && !searchBox.classList.contains('hidden')) {
      const focusable = Array.from(searchContainer.querySelectorAll<HTMLElement>('a[href], button, input, [tabindex]:not([tabindex="-1"])'))
      const first = focusable[0]
      const last = focusable.at(-1)
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault()
        last?.focus()
      }
      else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault()
        first?.focus()
      }
    }
  }, listenerOptions)

  disposeSearch = () => {
    controller.abort()
    requestId++
    if (closeTimer)
      window.clearTimeout(closeTimer)
    if (searchTimer)
      window.clearTimeout(searchTimer)
    document.body.style.overflow = ''
  }
}

document.addEventListener('astro:page-load', initSearchFeature)
document.addEventListener('astro:before-swap', () => disposeSearch())
</script>

<style>
  /* 搜索结果卡片动画 */
  #results > div {
    animation: fadeIn 0.3s ease forwards;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(5px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
