<a class="hidden md:flex items-center justify-center w-full h-full text-main hover:text-blue-500 cursor-pointer transition-colors duration-200 mr-2" id="search-icon" aria-label="搜索">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6">
    <circle cx="11" cy="11" r="8"></circle>
    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
  </svg>
</a>

<div class="hidden" id="search-box">
  <div
    id="search-backdrop"
    class="fixed z-[1000] left-0 top-0 backdrop-blur-xl h-screen w-screen overflow-hidden flex justify-center items-start bg-zinc-900/30 dark:bg-zinc-600/30"
  >
  </div>
  <div
    class="fixed left-1/2 top-32 -translate-x-1/2 z-[1001] w-[560px] bg-white/95 dark:bg-zinc-800/95 rounded-xl overflow-hidden shadow-xl dark:shadow-2xl backdrop-blur-md transform transition-all duration-300 opacity-0 scale-95 border border-blue-500/30"
    id="search-container"
  >
    <div class="p-4 relative">
      <input
        id="search-input"
        class="w-full p-3 pl-10 border-2 border-blue-500 rounded-lg focus:ring-0 focus:border-blue-500 outline-none bg-white/90 dark:bg-zinc-700/90 dark:text-white"
        type="text"
        placeholder="搜索文档"
        autocomplete="off"
        autofocus
      />
      <div class="absolute left-6 top-7 text-blue-500">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </div>
      <button 
        id="search-close" 
        class="absolute right-6 top-1/2 -translate-y-1/2 text-gray-500 hover:text-gray-700 dark:hover:text-gray-300 transition-colors duration-200 bg-white dark:bg-zinc-600 p-2 rounded-full"
        aria-label="关闭搜索"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div id="results" class="min-h-52 max-h-96 p-4 pt-0 overflow-auto space-y-2">
      <div class="w-full min-h-48 text-5xl flex justify-center items-center select-none">
        <span>🔍</span>
      </div>
    </div>
  </div>
</div>

<script type="module">
  try {
    const pagefind = await import('/pagefind/pagefind.js');
    // 初始化时设置语言偏好为中文
    pagefind.init({
      language: "zh"
    });

  } catch (error) {
    console.error('Failed to load pagefind:', error);
  }
</script>

<script type="module">
    // 节流函数：限制函数执行频率
    const throttle = (fn, delay) => {
      let last = 0;
      return (...args) => {
        const now = Date.now();
        if (now - last < delay) return;
        last = now;
        return fn(...args);
      };
    };
    
    // 初始化搜索功能
    const initSearchFeature = () => {
        // 元素选择
        const searchIcon = document.querySelector('#search-icon');
        const searchBox = document.querySelector('#search-box');
        const searchBackdrop = document.querySelector('#search-backdrop');
        const searchContainer = document.querySelector('#search-container');
        const searchInput = document.querySelector('#search-input');
        const searchClose = document.querySelector('#search-close');
        const resultsEl = document.querySelector('#results');
        
        if (!searchIcon || !searchBox) return;
        
        // 为避免重复绑定事件，先克隆替换搜索图标
        const newSearchIcon = searchIcon.cloneNode(true);
        searchIcon.parentNode?.replaceChild(newSearchIcon, searchIcon);
        newSearchIcon.addEventListener('click', openSearch);
       
        document.addEventListener('keydown', (e) => {
        // 检查是否按下 Ctrl+K 组合键
        if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
          e.preventDefault(); // 阻止默认行为
          openSearch(); // 调用打开搜索框的函数
        }
      });
        
        // 打开搜索框
        function openSearch() {
          document.body.style.overflow = 'hidden'; // 防止背景滚动
          searchBox.classList.remove('hidden');
          
          // 使用setTimeout创建淡入效果
          setTimeout(() => {
            searchContainer.classList.remove('opacity-0', 'scale-95');
            searchContainer.classList.add('opacity-100', 'scale-100');
            searchInput.focus();
          }, 10);
        }
        
        // 关闭搜索框
        function closeSearch() {
          document.body.style.overflow = '';
          searchContainer.classList.remove('opacity-100', 'scale-100');
          searchContainer.classList.add('opacity-0', 'scale-95');
          
          // 等待过渡效果完成后隐藏
          setTimeout(() => {
            searchBox.classList.add('hidden');
          }, 300);
        }
        
        // 同样处理关闭按钮
        if (searchClose) {
            const newSearchClose = searchClose.cloneNode(true);
            searchClose.parentNode?.replaceChild(newSearchClose, searchClose);
            newSearchClose.addEventListener('click', closeSearch);
        }
        
        // 背景点击关闭
        if (searchBackdrop) {
            const newSearchBackdrop = searchBackdrop.cloneNode(true);
            searchBackdrop.parentNode?.replaceChild(newSearchBackdrop, searchBackdrop);
            newSearchBackdrop.addEventListener('click', closeSearch);
        }
        
        // ESC键关闭
        const handleKeyDown = (e) => {
          if (e.key === 'Escape' && !searchBox.classList.contains('hidden')) {
            closeSearch();
          }
        };
        
        // 移除之前的keydown事件监听，避免重复
        document.removeEventListener('keydown', handleKeyDown);
        document.addEventListener('keydown', handleKeyDown);
        
        // 搜索功能
        if (searchInput && resultsEl) {
            // 移除之前的input事件监听，避免重复
            const newSearchInput = searchInput.cloneNode(true);
            searchInput.parentNode?.replaceChild(newSearchInput, searchInput);
            
            // 使用节流函数包装handleSearch，限制300ms内最多执行一次
            newSearchInput.addEventListener('input', throttle(handleSearch, 300));
        }
        
        async function handleSearch(e) {
            const { value } = e.target;
            if (!value.trim()) {
              resultsEl.innerHTML = `
                <div class="w-full min-h-48 text-5xl text-center flex justify-center items-center select-none">
                  <div>🔍</div>
                </div>
              `;
              return;
            }
            
            // 显示加载状态
            resultsEl.innerHTML = `
              <div class="w-full min-h-48 text-center flex justify-center items-center select-none">
                <div class="animate-pulse flex flex-col items-center">
                  <div class="text-3xl mb-2">🔍</div>
                  <div class="text-sm text-gray-500">搜索中...</div>
                </div>
              </div>
            `;
            
            let html = '';
            try {
              const pagefind = await import('/pagefind/pagefind.js');
              
              // 优化中文搜索参数
              const search = await pagefind.search(value, {
                language: "zh",
                sort: { date: "desc" },
                filters: {},
                // 中文搜索优化选项
                tokenize: true,
                and_mode: true,
                expand_results: true,
                minimum_match_score: 0.2
              });
              
              if (!search || !search.results || search.results.length === 0) {
                resultsEl.innerHTML = `
                  <div class="w-full min-h-48 text-xl text-center flex justify-center items-center select-none text-gray-500">
                    <div>未找到相关结果</div>
                  </div>
                `;
                return;
              }
              
              const results = search.results.map((item) => item.data());
              const data = await Promise.all(results);
              
              // 显示结果数量
              html += `<div class="text-sm text-gray-500 mb-3 px-1">找到 ${data.length} 条结果</div>`;
              
              data.forEach(({ meta: { title }, url, excerpt }) => {
                // 更改高亮样式，使用不同于标题的颜色
                const highlightedExcerpt = excerpt.replaceAll('<mark', '<mark class="bg-amber-500/90 text-white dark:text-white px-0.5 py-0.5 rounded"');
                
                html += `
                <div class="bg-white dark:bg-zinc-700 p-3 rounded-lg shadow-md hover:shadow-lg transition-all duration-200 border border-gray-100 dark:border-zinc-600">
                  <a href="${url}" class="text-blue-500 hover:text-blue-600 transition-colors duration-200 font-medium text-lg">${title}</a>
                  <p class="text-gray-600 dark:text-gray-300 text-sm line-clamp-2 text-ellipsis mt-1 ml-2">${highlightedExcerpt}</p>
                </div>
              `;
              });
              resultsEl.innerHTML = html;
            } catch (error) {
              console.error('搜索出错:', error);
              resultsEl.innerHTML = `
                <div class="w-full min-h-48 text-xl text-center flex flex-col justify-center items-center select-none text-red-500">
                  <div class="mb-2">搜索出错</div>
                  <div class="text-sm text-gray-500">${error.message || '未知错误'}</div>
                </div>
              `;
            }
        }
    };
    
    // 在页面加载和Astro页面切换后初始化搜索功能
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initSearchFeature);
     
    } else {
        initSearchFeature();
    }
    
    // 监听Astro页面切换事件
    document.addEventListener('astro:after-swap', initSearchFeature);
</script>

<style>
  /* 搜索结果卡片动画 */
  #results > div {
    animation: fadeIn 0.3s ease forwards;
  }
  
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(5px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
    