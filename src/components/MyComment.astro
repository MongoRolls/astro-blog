<div id="twikoo_visitors" class="font-serif text-sm">number: 0</div>
<div id="tcomment"></div>

<!-- 只执行一次，点击其他博客跳转没有触发，可能是视图切换 -->
<script is:inline > 
function initTwikoo() {
 twikoo.init({
   envId: 'https://comment.mongorolls.cn/', 
   el: '#tcomment', 
   emotionCDN: 'https://raw.githubusercontent.com/ZhangKeLiang0627/ZhangKeLiang0627.github.io/main/img/sys/owo.json',
 });
}
</script>

<script>
    document.addEventListener('astro:page-load', () => {
        
        let script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/twikoo@1.6.44/dist/twikoo.min.js?v=1.0.0';
        script.onload = () => {
            (window as any).initTwikoo();
        };
        document.body.appendChild(script);
    });
</script>