---
import type { Locale } from '../i18n/config'
import { alternateLocale, localeInfo } from '../i18n/config'
import { useTranslations } from '../i18n/ui'
import IconButton from './IconButton.astro'

type Props = {
  locale: Locale
  href: string
  exactMatch?: boolean
}

const { locale, href, exactMatch = true } = Astro.props
const targetLocale = alternateLocale(locale)
const t = useTranslations(locale)
const label = exactMatch ? t.language.switchTo : t.language.unavailable
---

<IconButton
  href={href}
  class="nav-action language-toggle"
  aria-label={label}
  title={label}
  hreflang={localeInfo[targetLocale].htmlLang}
  data-exact-match={exactMatch ? 'true' : 'false'}
  {...{ 'data-astro-reload': true }}
>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <path d="M3 5h12M9 3v2M12 5c-1 5-4 8-8 10M6 8c1 3 4 6 7 7M14 21l4-10 4 10M15.2 18h5.6"></path>
  </svg>
  {!exactMatch && <span class="translation-status" aria-hidden="true"></span>}
</IconButton>

<style>
  .translation-status {
    position: absolute;
    top: 0.3rem;
    right: 0.3rem;
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 999px;
    background: currentColor;
  }
</style>
