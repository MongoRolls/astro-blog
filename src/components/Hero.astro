---
/* 首页 */
import { marked } from 'marked';
import Button from './Button.astro';
import siteConfig from '../data/site-config';
import { Image } from 'astro:assets';
const hero = siteConfig.hero!;

// 预先解析markdown以避免在渲染时解析
const parsedText = hero?.text ? marked.parse(hero.text) : '';
---

{
    (hero?.title || hero?.image?.src || hero?.text || (hero?.actions && hero.actions.length > 0)) && (
        <section class="w-full flex flex-col gap-8 mb-16 sm:mb-24">
            {hero.title && <h1 class="text-3xl leading-tight font-serif font-medium sm:text-5xl sm:leading-tight">{hero.title}</h1>}
            {hero.image?.src && (
                <figure>
                    <Image
                        class="w-full rounded-xl hero-image"
                        src={hero.image.src}
                        data-aos="flip-left"
                        alt={hero.image.alt || ''}
                        loading="lazy"
                        width={1200}
                        height={800}
                        decoding="async"
                    />
                </figure>
            )}
            {hero.text && <div class="max-w-none prose-lg  md:prose-lg typing" set:html={parsedText} />}
            {hero.actions && hero.actions.length > 0 && (
                <div class="flex flex-wrap gap-4">
                    {hero.actions.map((action) => (
                        <Button href={action.href}>{action.text}</Button>
                    ))}
                </div>
            )}
        </section>
    )
}

<style>
    /* 优化后的夜间模式样式 */
    :global(.dark) .hero-image {
        filter: brightness(0.8);
        transition: transform 0.3s ease;
    }

    :global(.dark) .hero-image:hover {
        transform: translateY(-2px);
    }

    /* 使用CSS @property来优化动画性能 */
    @property --glow-opacity {
        syntax: '<number>';
        initial-value: 0.3;
        inherits: false;
    }

    :global(.dark) .hero-image {
        box-shadow: 0 0 20px rgba(147, 197, 253, var(--glow-opacity));
    }

    @media (prefers-reduced-motion: no-preference) {
        :global(.dark) .hero-image {
            animation: subtle-glow 3s ease-in-out infinite;
        }
    }

    @keyframes subtle-glow {
        0%, 100% { --glow-opacity: 0.3; }
        50% { --glow-opacity: 0.5; }
    }
</style>