---
// 动画签名组件
export interface Props {
  /** 动画持续时间 */
  animationDuration?: string
  /** 边框颜色 */
  strokeColor?: string
  /** 填充颜色 */
  fillColor?: string
  /** 暗色模式下边框颜色 */
  darkStrokeColor?: string
  /** 暗色模式下填充颜色 */
  darkFillColor?: string
  /** SVG宽度 */
  width?: string
  /** SVG高度 */
  height?: string
  /** 边框宽度 */
  strokeWidth?: number
  /** 是否在移动端隐藏 */
  hiddenOnMobile?: boolean
  /** 动画开始延迟间隔 */
  delayInterval?: number
  /** 自定义CSS类名 */
  className?: string
}

const {
  animationDuration = '25s',
  strokeColor = 'currentColor',
  fillColor = 'currentColor',
  darkStrokeColor = '#fdfdfd',
  darkFillColor = '#fdfdfd',
  width = '117px',
  height = '51px',
  strokeWidth = 12,
  delayInterval = 0.15,
  className = '',
} = Astro.props

// 计算各个路径的延迟时间
const pathDelays = Array.from({ length: 7 }, (_, i) => `${i * delayInterval}s`)

// 映射为独立的主题变量
const lightFillColor = fillColor
const actualDarkFillColor = darkFillColor;
