  class={`signature-container ${className}`}
  version="1.0"
  xmlns="http://www.w3.org/2000/svg"
  width={width}
  height={height}
  viewBox="0 0 374.000000 172.000000"
  preserveAspectRatio="xMidYMid meet"
>

