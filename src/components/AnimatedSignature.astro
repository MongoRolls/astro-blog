<style
  lang="scss"
  define:vars={{
  animationDuration,
  strokeColor,
  lightFillColor,
  strokeWidth,
  darkStrokeColor,
  actualDarkFillColor,
  ...Object.fromEntries(pathDelays.map((delay, i) => [`path${i + 1}Delay`, delay])),
}}
>
  .signature-container {
    display: inline-block;
    // width: 100%;
    // height: 100%;
  }

  .signature-path {
    stroke: var(--strokeColor);
    stroke-width: var(--strokeWidth);
    stroke-dasharray: 7600;
    stroke-dashoffset: 7600;
    fill: transparent;
    animation: drawSignature var(--animationDuration) ease-in-out infinite;
  }
/*
  .path-1 { animation-delay: var(--path1Delay); }
  .path-2 { animation-delay: var(--path2Delay); }
  .path-3 { animation-delay: var(--path3Delay); }
  .path-4 { animation-delay: var(--path4Delay); }
  .path-5 { animation-delay: var(--path5Delay); }
  .path-6 { animation-delay: var(--path6Delay); }
  .path-7 { animation-delay: var(--path7Delay); } */

  @keyframes drawSignature {
    0% {
      stroke-dashoffset: 7600;
      fill: transparent;
    }

    15% {
      stroke-dashoffset: 0;
      fill: transparent;
    }

    30% {
      stroke-dashoffset: 0;
      fill: var(--lightFillColor);
    }

    67% {
      stroke-dashoffset: 0;
      fill: var(--lightFillColor);
    }

    92% {
      stroke-dashoffset: 7600;
      fill: transparent;
    }
  }

  @keyframes drawSignatureDark {
    0% {
      stroke-dashoffset: 7600;
      fill: transparent;
    }

    15% {
      stroke-dashoffset: 0;
      fill: transparent;
    }

    30% {
      stroke-dashoffset: 0;
      fill: var(--actualDarkFillColor);
    }

    67% {
      stroke-dashoffset: 0;
      fill: var(--actualDarkFillColor);
    }

    89%,
    100% {
      stroke-dashoffset: 7600;
      fill: transparent;
    }
  }

  /* 移动端隐藏选项 */
  @media (max-width: 768px) {
    .signature-container {
      display: none;
    }
  }

  /* 暗色模式支持 */
  :global(.dark) .signature-path {
    stroke: var(--darkStrokeColor);
    animation: drawSignatureDark var(--animationDuration) ease-in-out infinite;
  }
</style>

<script is:inline>
document.addEventListener('astro:page-load', () => {
  const signaturePath = document.querySelectorAll('.signature-path')
  let maxLength = 0
  signaturePath.forEach((path) => {
    maxLength = Math.max(maxLength, path?.getTotalLength())
  })
  // console.log('maxLength', maxLength)
})
</script>
