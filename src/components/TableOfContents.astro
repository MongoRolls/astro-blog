---
interface Props {
    headings: {
        depth: number
        slug: string
        text: string
    }[]
}

const { headings } = Astro.props
const toc = headings.filter(({ depth }) => depth > 1 && depth < 4)
---

<nav data-pagefind-ignore class="toc hidden lg:block h-full">
    <div class="sticky top-24 max-h-[70vh] overflow-y-auto">
        <h2 class="font-serif italic mb-3 text-xs leading-4 font-semibold text-gray-900 dark:text-gray-100 uppercase tracking-wider ml-4">Content</h2>
        <ul class="space-y-1 text-xs leading-4 border-l border-gray-200 dark:border-gray-800">
        {
                toc.map(heading => (
                    <li
                      class:list={[
                            'toc-item line-clamp-1 relative flex items-center',
                            {
                                'pl-4': heading.depth === 2,
                                'pl-6': heading.depth === 3,
                            },
                        ]}
                    >
                        {heading.depth === 3 && <span class="text-gray-500 dark:text-gray-400 pr-2 font-semibold">-</span>}
                        <a
                          href={`#${heading.slug}`}
                          class="truncate block text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-200 transition-all duration-200"
                        >{heading.text}
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
</nav>

<style>
    @reference "../styles/global.css";

    .toc {
        width: 220px;
        padding-left: 1rem;
    }

    .toc-item {
        line-height: 1rem;
        font-size: 0.75rem;
    }

    /* 激活状态的样式 */
    .toc-item.active > a {
        @apply text-blue-600 dark:text-blue-400 font-semibold translate-x-0.5 scale-105;
    }

    .toc-item.active::before {
        content: "";
        position: absolute;
        left: -1px;
        top: 0;
        bottom: 0;
        width: 3px;
        border-radius: 4px;
        transition: all 0.15s ease-in-out;
        @apply bg-blue-600 dark:bg-blue-400;
    }

</style>

<script>
let disposeTableOfContents = () => {}

document.addEventListener('astro:page-load', () => {
  disposeTableOfContents()

  const controller = new AbortController()
  // 记录当前活跃的目录项ID
  let activeId = ''

  // 创建交叉观察器
  const observer = new IntersectionObserver(
    (entries) => {
      // 获取所有当前可见的标题元素
      const visibleHeadings = entries
        .filter(entry => entry.isIntersecting)
        .map(entry => entry.target)

      if (visibleHeadings.length > 0) {
        // 按照在视口中的位置排序，选择最靠近顶部的标题
        const topHeading = Array.from(visibleHeadings).sort((a, b) => {
          return Math.abs(a.getBoundingClientRect().top) - Math.abs(b.getBoundingClientRect().top)
        })[0]

        const id = topHeading.getAttribute('id')

        // 只有在活跃ID变化时才更新DOM
        if (id && id !== activeId) {
          activeId = id

          // 移除所有当前活跃项
          document.querySelectorAll('.toc-item.active').forEach(item =>
            item.classList.remove('active'))

          // 添加新的活跃项
          const tocItem = document.querySelector(`.toc-item a[href="#${id}"]`)?.parentElement
          tocItem?.classList.add('active')
        }
      }
    },
    // {
    //     // rootMargin值解释:
    //     // 顶部-10%: 标题必须至少进入视口10%才被考虑
    //     // 底部-70%: 忽略视口底部70%区域内的标题
    //     // 这样可以更好地突出当前阅读区域的标题
    //     // rootMargin: '-10% 0px -70% 0px'
    // }

  )

  // 观察所有标题元素
  document.querySelectorAll('main h2[id], main h3[id]').forEach((heading) => {
    observer.observe(heading)
  })

  disposeTableOfContents = () => {
    controller.abort()
    observer.disconnect()
  }
})

document.addEventListener('astro:before-swap', () => disposeTableOfContents())
</script>
