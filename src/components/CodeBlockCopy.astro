---
import type { Locale } from '../i18n/config'
import { defaultLocale } from '../i18n/config'
import { useTranslations } from '../i18n/ui'

type Props = { locale?: Locale }
const { locale = defaultLocale } = Astro.props
const t = useTranslations(locale)
---

<template data-code-copy data-code-copied-label={t.common.codeCopied} data-code-copy-failed-label={t.common.codeCopyFailed}>
  <button type="button" class="code-copy-button" data-pagefind-ignore="all" aria-label={t.common.codeCopy}>
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <g class="copy-icon">
        <rect x="9" y="9" width="13" height="13" rx="2" />
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
      </g>
      <path class="copied-icon" d="m5 12 4 4L19 6" />
      <path class="copy-error-icon" d="m6 6 12 12M18 6 6 18" />
    </svg>
  </button>
</template>

<script>
let disposeCodeBlockCopy = () => {}

function fallbackCopy(text: string) {
  const previouslyFocused = document.activeElement as HTMLElement | null
  const textarea = document.createElement('textarea')
  textarea.value = text
  textarea.setAttribute('readonly', '')
  textarea.style.position = 'fixed'
  textarea.style.opacity = '0'
  document.body.appendChild(textarea)
  textarea.select()

  const copied = document.execCommand('copy')
  textarea.remove()
  previouslyFocused?.focus()
  if (!copied)
    throw new Error('浏览器不支持复制操作')
}

async function copyText(text: string) {
  if (navigator.clipboard && window.isSecureContext) {
    try {
      await navigator.clipboard.writeText(text)
      return
    }
    catch {
      // 权限受限时继续尝试兼容方案。
    }
  }

  fallbackCopy(text)
}

function initCodeBlockCopy() {
  disposeCodeBlockCopy()

  const controller = new AbortController()
  const resetTimers = new Set<number>()
  const template = document.querySelector<HTMLTemplateElement>('template[data-code-copy]')
  const original = template?.content.querySelector('button')
  if (!template || !original)
    return
  const copyLabel = original.getAttribute('aria-label')!
  const copiedLabel = template.dataset.codeCopiedLabel!
  const failedLabel = template.dataset.codeCopyFailedLabel!

  document.querySelectorAll<HTMLElement>('.prose pre').forEach((pre) => {
    if (pre.parentElement?.classList.contains('code-block-wrapper'))
      return

    const wrapper = document.createElement('div')
    wrapper.className = 'code-block-wrapper'
    pre.before(wrapper)
    wrapper.append(original.cloneNode(true), pre)
  })

  document.addEventListener('click', async (event) => {
    const target = event.target
    if (!(target instanceof Element))
      return

    const button = target.closest<HTMLButtonElement>('.code-copy-button')
    if (!button)
      return

    const code = button.parentElement?.querySelector('pre code')
    if (!code)
      return

    button.disabled = true
    try {
      await copyText(code.textContent ?? '')
      button.dataset.state = 'success'
      button.setAttribute('aria-label', copiedLabel)
    }
    catch (error) {
      console.warn('代码复制失败:', error)
      button.dataset.state = 'error'
      button.setAttribute('aria-label', failedLabel)
    }

    const timer = window.setTimeout(() => {
      button.disabled = false
      button.removeAttribute('data-state')
      button.setAttribute('aria-label', copyLabel)
      resetTimers.delete(timer)
    }, 2000)
    resetTimers.add(timer)
  }, { signal: controller.signal })

  disposeCodeBlockCopy = () => {
    controller.abort()
    resetTimers.forEach(timer => window.clearTimeout(timer))
    resetTimers.clear()
  }
}

document.addEventListener('astro:page-load', initCodeBlockCopy)
document.addEventListener('astro:before-swap', () => disposeCodeBlockCopy())
</script>

<style>
  :global(.prose .code-block-wrapper) {
    position: relative;
    margin-block: 1.7142857em;
  }

  :global(.prose .code-block-wrapper > pre) {
    margin-block: 0;
    /* The top border stays outside the scrollport, so long lines never pass under the button. */
    border-block-start: 2.5rem solid transparent;
    padding-block-start: 0.25rem;
  }

  :global(.code-copy-button) {
    position: absolute;
    inset-block-start: 0.25rem;
    inset-inline-end: 0.4rem;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: 0.375rem;
    background: rgb(39 39 42 / 0.88);
    color: rgb(244 244 245);
    font-family: inherit;
    font-size: 0.75rem;
    line-height: 1.25rem;
    cursor: pointer;
    opacity: 0.78;
    transition: opacity 150ms ease, background-color 150ms ease, border-color 150ms ease;
  }

  :global(.code-copy-button .copied-icon),
  :global(.code-copy-button .copy-error-icon),
  :global(.code-copy-button[data-state] .copy-icon) { display: none; }

  :global(.code-copy-button[data-state='success'] .copied-icon),
  :global(.code-copy-button[data-state='error'] .copy-error-icon) { display: inline; }

  :global(.code-block-wrapper:hover .code-copy-button),
  :global(.code-copy-button:focus-visible) {
    opacity: 1;
  }

  :global(.code-copy-button:focus-visible) {
    outline: 2px solid rgb(96 165 250);
    outline-offset: 2px;
  }

  :global(.code-copy-button[data-state='success']) {
    border-color: rgb(74 222 128 / 0.6);
    background: rgb(21 128 61 / 0.92);
  }

  :global(.code-copy-button[data-state='error']) {
    border-color: rgb(248 113 113 / 0.65);
    background: rgb(185 28 28 / 0.92);
  }

  :global(.code-copy-button:disabled) {
    cursor: default;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.code-copy-button) {
      transition: none;
    }
  }
</style>
