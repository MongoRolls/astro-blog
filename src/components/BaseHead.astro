---
import type { Locale } from '../i18n/config'
import { getSiteConfig } from '../data/site-config'
import { defaultLocale, localeInfo, localizedPath } from '../i18n/config'
import '@fontsource-variable/inter'
import '@fontsource-variable/newsreader'
import '@fontsource/fira-code/400.css'
import '@fontsource/fira-code/500.css'
import '@fontsource/fira-code/600.css'
import 'remark-github-blockquote-alert/alert.css'
import '../styles/global.css'

export type Props = {
    title?: string
    description?: string
    image?: { src: string, alt?: string }
    pageType?: 'website' | 'article'
    keywords?: string[]
    author?: string
    publishDate?: Date
    updatedDate?: Date
    tags?: string[]
    robots?: string
    prevUrl?: string
    nextUrl?: string
    locale?: Locale
    alternateUrls?: Partial<Record<Locale, string>>
}

const {
    locale = defaultLocale,
    pageType = 'website',
    publishDate,
    updatedDate,
    tags = [],
    robots,
    prevUrl,
    nextUrl,
    alternateUrls,
} = Astro.props
const siteConfig = getSiteConfig(locale)
const description = Astro.props.description ?? siteConfig.description
const image = Astro.props.image ?? siteConfig.image
const keywords = Astro.props.keywords ?? siteConfig.keywords ?? []
const author = Astro.props.author ?? siteConfig.author
const title = [Astro.props.title, siteConfig.title].filter(Boolean).join(' | ')
const resolvedImage = image?.src
    ? {
          src: new URL(image.src, Astro.site).toString(),
          alt: image.alt,
      }
    : undefined
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const siteUrl = siteConfig.website ?? Astro.site?.toString() ?? canonicalURL.origin
const githubUrl = siteConfig.socialLinks?.find(link => link.text === 'github')?.href
const modifiedDate = updatedDate ?? publishDate

/**
 * Enforce some standard canonical URL formatting across the site.
 */
function formatCanonicalURL(url: string | URL) {
    const path = url.toString()
    return path.replace(/\/?$/, '/')
}

function toAbsoluteURL(path: string) {
    return formatCanonicalURL(new URL(path, Astro.site))
}

const canonical = formatCanonicalURL(canonicalURL)
const indexable = !robots?.includes('noindex')
const alternateEntries = Object.entries(alternateUrls ?? {}) as [Locale, string][]
const personSchema = {
    '@type': 'Person',
    'name': author || siteConfig.author,
    'url': formatCanonicalURL(siteUrl),
    ...(githubUrl ? { sameAs: [githubUrl] } : {}),
}
const websiteSchema = {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    'name': siteConfig.title,
    'url': formatCanonicalURL(siteUrl),
    'description': siteConfig.description,
    'inLanguage': siteConfig.language || 'zh-CN',
    'author': personSchema,
}
const articleSchema = pageType === 'article'
    ? {
            '@context': 'https://schema.org',
            '@type': 'BlogPosting',
            'headline': Astro.props.title ?? title,
            'description': description,
            'image': resolvedImage?.src,
            'datePublished': publishDate?.toISOString(),
            'dateModified': modifiedDate?.toISOString(),
            'inLanguage': siteConfig.language || 'zh-CN',
            'keywords': keywords.length > 0 ? keywords.join(', ') : undefined,
            'author': personSchema,
            'publisher': personSchema,
            'mainEntityOfPage': {
                '@type': 'WebPage',
                '@id': canonical,
            },
        }
    : undefined

function toJsonLd(data: unknown) {
    return JSON.stringify(data).replaceAll('<', '\\u003c')
}
---

<!-- High Priority Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title}</title>
<meta name="generator" content={Astro.generator} />
{robots && <meta name="robots" content={robots} />}

<!-- DNS Prefetch -->
<link rel="dns-prefetch" href="//mongorolls-images.oss-cn-shenzhen.aliyuncs.com" />

<!-- Low Priority Global Metadata -->
 <!-- ico 更换后记得强制刷新不然会有缓存 -->
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={`${siteConfig.title} RSS`} href={new URL(localizedPath(locale, '/rss.xml'), Astro.site).toString()} />
<link rel="alternate" type="text/plain" title={`${siteConfig.title} LLM index`} href={new URL(localizedPath(locale, '/llms.txt'), Astro.site).toString()} />

<!-- Page Metadata -->
{indexable && <link rel="canonical" href={canonical} />}
{indexable && alternateEntries.map(([alternateLocale, url]) => (
  <link rel="alternate" hreflang={localeInfo[alternateLocale].htmlLang} href={toAbsoluteURL(url)} />
))}
{indexable && alternateUrls?.[defaultLocale] && (
  <link rel="alternate" hreflang="x-default" href={toAbsoluteURL(alternateUrls[defaultLocale])} />
)}
{prevUrl && <link rel="prev" href={toAbsoluteURL(prevUrl)} />}
{nextUrl && <link rel="next" href={toAbsoluteURL(nextUrl)} />}
<meta name="description" content={description} />
{keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
{author && <meta name="author" content={author} />}
<meta name="theme-color" content={siteConfig.themeColor || '#425bc5'} />
<meta name="msapplication-TileColor" content={siteConfig.themeColor || '#425bc5'} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={pageType} />
{indexable && <meta property="og:url" content={canonical} />}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content={siteConfig.title} />
<meta property="og:locale" content={siteConfig.locale || 'zh_CN'} />
{alternateEntries.filter(([alternateLocale]) => alternateLocale !== locale).map(([alternateLocale]) => (
  <meta property="og:locale:alternate" content={localeInfo[alternateLocale].ogLocale} />
))}
{resolvedImage?.src && <meta property="og:image" content={resolvedImage.src} />}
{resolvedImage?.src && <meta property="og:image:width" content="1200" />}
{resolvedImage?.src && <meta property="og:image:height" content="630" />}
{resolvedImage?.alt && <meta property="og:image:alt" content={resolvedImage.alt} />}
{pageType === 'article' && author && <meta property="article:author" content={author} />}
{pageType === 'article' && publishDate && <meta property="article:published_time" content={publishDate.toISOString()} />}
{pageType === 'article' && modifiedDate && <meta property="article:modified_time" content={modifiedDate.toISOString()} />}
{pageType === 'article' && tags.map(tag => <meta property="article:tag" content={tag} />)}

<!-- X/Twitter -->
<meta name="twitter:card" content="summary_large_image" />
{indexable && <meta name="twitter:url" content={canonical} />}
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{resolvedImage?.src && <meta name="twitter:image" content={resolvedImage.src} />}
{resolvedImage?.alt && <meta name="twitter:image:alt" content={resolvedImage.alt} />}

<script is:inline type="application/ld+json" set:html={toJsonLd(websiteSchema)} />
{articleSchema && <script is:inline type="application/ld+json" set:html={toJsonLd(articleSchema)} />}
