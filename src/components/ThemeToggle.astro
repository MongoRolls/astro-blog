---
---
<button
  id="theme-toggle"
  class="theme-toggle-btn"
  type="button"
  aria-label="切换主题"
  title="切换主题"
>
  <!-- 太阳图标 -->
  <svg class="sun-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
    <path d="M12 18C15.3137 18 18 15.3137 18 12C18 8.68629 15.3137 6 12 6C8.68629 6 6 8.68629 6 12C6 15.3137 8.68629 18 12 18Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path>
    <path d="M22 12L23 12" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path>
    <path d="M12 2V1" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path>
    <path d="M12 23V22" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path>
    <path d="M20 20L19 19" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path>
    <path d="M20 4L19 5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path>
    <path d="M4 20L5 19" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path>
    <path d="M4 4L5 5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path>
    <path d="M1 12L2 12" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>

  <!-- 月亮图标 -->
  <svg class="moon-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
    <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
    <path d="M12 3c.132 0 .263 0 .393 0a7.5 7.5 0 0 0 7.92 12.446a9 9 0 1 1 -8.313 -12.454z"></path>
    <path d="M17 4a2 2 0 0 0 2 2a2 2 0 0 0 -2 2a2 2 0 0 0 -2 -2a2 2 0 0 0 2 -2"></path>
    <path d="M19 11h2m-1 -1v2"></path>
  </svg>
</button>

<script is:inline>
// 使用 is:inline 确保脚本立即执行而不被 Astro 处理
// 立即检查并设置主题状态
(function () {
  // 检查主题状态
  const savedTheme = localStorage.getItem('theme')
  const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches
  const isDark = savedTheme ? savedTheme === 'dark' : prefersDark

  // 立即应用主题
  if (isDark) {
    document.documentElement.classList.add('dark')
  }
  else {
    document.documentElement.classList.remove('dark')
  }
})()
</script>

<script is:inline>
// 主题切换处理函数
function handleThemeToggle(isDark) {
  const html = document.documentElement
  if (isDark) {
    html.classList.add('dark')
  }
  else {
    html.classList.remove('dark')
  }
  localStorage.setItem('theme', isDark ? 'dark' : 'light')
}

function handleThemeChange() {
  const isDark = !getCurrentThemeState()
  handleThemeToggle(isDark)
  // CSS会自动处理图标状态，不需要手动更新
}

// 检测当前的主题状态
function getCurrentThemeState() {
  // 优先检查 HTML 元素的 class，因为这反映了当前实际的主题状态
  if (document.documentElement.classList.contains('dark')) {
    return true
  }

  // 其次检查本地存储
  const savedTheme = localStorage.getItem('theme')
  if (savedTheme) {
    return savedTheme === 'dark'
  }

  // 最后检查系统偏好
  return window.matchMedia('(prefers-color-scheme: dark)').matches
}

// 初始化主题
function initializeTheme() {
  const isDark = getCurrentThemeState()

  // 应用主题（CSS会自动处理图标状态）
  handleThemeToggle(isDark)
}

// 事件绑定
function setupListeners() {
  // 直接绑定到所有主题切换按钮
  const themeButtons = document.querySelectorAll('#theme-toggle')
  themeButtons.forEach((button) => {
    button.addEventListener('click', handleThemeChange)
  })

  // 监听系统主题变化
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    if (localStorage.getItem('theme') === null) { // 只有当用户没有手动设置主题时才响应
      const isDark = e.matches
      handleThemeToggle(isDark)
      // CSS会自动处理图标状态
    }
  })
}

// Astro 页面生命周期处理
document.addEventListener('astro:before-preparation', () => {
  // 确保跳转前保存当前主题状态
  const isDark = getCurrentThemeState()
  localStorage.setItem('theme', isDark ? 'dark' : 'light')
})

document.addEventListener('astro:page-load', () => {
  // 页面加载完成后立即设置主题和按钮状态
  initializeTheme()
  setupListeners()
})

document.addEventListener('astro:after-swap', () => {
  // 页面内容交换后，重新设置状态
  initializeTheme()
  setupListeners()
})

// 立即执行初始化
document.addEventListener('DOMContentLoaded', () => {
  initializeTheme()
  setupListeners()
})

// 如果DOM已经加载完成，立即执行
if (document.readyState !== 'loading') {
  initializeTheme()
  setupListeners()
}
</script>

<style>
.theme-toggle-btn {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: none;
  cursor: pointer;
  transition: all 0.08s ease-in-out;
  padding: 4px;
}

.theme-toggle-btn:hover {
  transform: scale(1.05);
}

.theme-toggle-btn:active {
  transform: scale(0.95);
}

.sun-icon,
.moon-icon {
  position: absolute;
  width: 24px;
  height: 24px;
  transition: all 0.08s ease-in-out;
  color: currentColor;
}

/* 默认状态：浅色模式显示太阳，深色模式显示月亮 */
.sun-icon {
  opacity: 1;
  transform: scale(1);
}

.moon-icon {
  opacity: 0;
  transform: scale(0);
}

/* 深色模式下的图标状态 */
:global(.dark) .sun-icon {
  opacity: 0;
  transform: scale(0);
}

:global(.dark) .moon-icon {
  opacity: 1;
  transform: scale(1);
}

/* 深色模式下的样式调整 */

/* 图标颜色适应主题 */
.sun-icon,
.moon-icon {
  color: #000000;
}

:global(.dark) .sun-icon,
:global(.dark) .moon-icon {
  color: #ffffff;
}
</style>

