---

---

<button
    id="theme-toggle"
    class="relative w-12 h-6 flex items-center bg-gray-300 dark:bg-gray-600 rounded-full px-1 transition-all duration-300 ease-in-out focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-500 border border-gray-400/30 dark:border-gray-500/30 hover:border-gray-400 dark:hover:border-gray-400 shadow-sm hover:shadow-md"
    aria-label="切换颜色主题"
>
    <!-- 滑块背景 -->
    <div class="absolute inset-0 rounded-full transition-opacity duration-300 ease-in-out overflow-hidden">
        <div class="absolute inset-1 rounded-full bg-gradient-to-tr from-yellow-200 to-yellow-400 opacity-70 dark:opacity-0"></div>
        <div class="absolute inset-1 rounded-full bg-gradient-to-tr from-blue-800 to-gray-900 opacity-0 dark:opacity-70"></div>
    </div>

    <!-- 滑块指示器 -->
    <span 
        class="relative w-4 h-4 bg-white rounded-full shadow-sm transform transition-all duration-300 ease-in-out dark:translate-x-6 border border-gray-200 dark:border-gray-600"
    >
        <!-- 太阳图标 -->
        <span class="absolute inset-0 flex items-center justify-center text-yellow-500 dark:opacity-0 transition-opacity duration-300 ease-in-out">
            <svg class="w-3 h-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" clip-rule="evenodd" />
            </svg>
        </span>
        <!-- 月亮图标 -->
        <span class="absolute inset-0 flex items-center justify-center text-gray-200 opacity-0 dark:opacity-100 transition-opacity duration-300 ease-in-out">
            <svg class="w-3 h-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z" />
            </svg>
        </span>
    </span>

    <!-- 悬停时的光晕效果 -->
    <div class="absolute inset-0 rounded-full opacity-0 transition-opacity duration-300 ease-in-out group-hover:opacity-100">
        <div class="absolute inset-0 rounded-full bg-gradient-to-r from-yellow-200/20 to-yellow-400/20 dark:from-blue-800/20 dark:to-gray-900/20 blur-sm"></div>
    </div>
</button>

<script>
    document.addEventListener('astro:page-load', () => {
        const theme = (() => {
            if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
                return localStorage.getItem('theme') || 'light';
            }
            if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
                return 'dark';
            }
            return 'light';
        })();

        if (theme === 'light') {
            document.documentElement.classList.remove('dark');
        } else {
            document.documentElement.classList.add('dark');
        }

        window.localStorage.setItem('theme', theme);

        const handleToggleClick = () => {
            const element = document.documentElement;
            element.classList.toggle('dark');

            const isDark = element.classList.contains('dark');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');

            // 添加切换动画效果
            const toggle = document.getElementById('theme-toggle');
            toggle?.classList.add('animate-toggle');
            setTimeout(() => {
                toggle?.classList.remove('animate-toggle');
            }, 300);
        };

        document.getElementById('theme-toggle')?.addEventListener('click', handleToggleClick);
    });
</script>

<script>
    document.addEventListener('astro:after-swap', () => {
        if (localStorage.theme === 'dark') {
            document.documentElement.classList.add('dark');
        }
    });
</script>

<style>
    @keyframes toggle {
        0% { transform: scale(1); }
        50% { transform: scale(0.95); }
        100% { transform: scale(1); }
    }

    .animate-toggle {
        animation: toggle 0.3s ease-in-out;
    }

    #theme-toggle {
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
    }

    #theme-toggle:hover {
        cursor: pointer;
        box-shadow: 0 0 10px rgba(0,0,0,0.1);
    }

    #theme-toggle:hover span {
        transform: scale(1.05);
    }

    /* 添加玻璃拟态效果 */
    #theme-toggle::before {
        content: '';
        position: absolute;
        inset: -1px;
        padding: 1px;
        background: linear-gradient(
            45deg,
            transparent 40%,
            rgba(255, 255, 255, 0.2) 45%,
            rgba(255, 255, 255, 0.3) 50%,
            rgba(255, 255, 255, 0.2) 55%,
            transparent 60%
        );
        border-radius: 9999px;
        mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
        -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
        opacity: 0;
        transition: opacity 0.3s ease-in-out;
    }

    #theme-toggle:hover::before {
        opacity: 1;
    }
</style>

