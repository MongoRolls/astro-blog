---
import type { CollectionEntry } from 'astro:content'
import type { Locale } from '../i18n/config'
import { COVER_HEIGHT, COVER_WIDTH, getPostCoverImage } from '../config/image'
import { defaultLocale } from '../i18n/config'
import { useTranslations } from '../i18n/ui'
import { getPostUrl } from '../utils/data-utils'
import { getReadingStats, stripInlineMarkdown } from '../utils/reading-stats'
import FormattedDate from './FormattedDate.astro'

type Props = { post: CollectionEntry<'blog'>, class?: string, headingLevel?: 'h2' | 'h3', locale?: Locale }

function extractFirstParagraph(body = '', maxLength = 180) {
  const withoutComments = body
    .replace(/\{\/\*[\s\S]*?\*\/\}/g, '')
    .replace(/<!--[\s\S]*?-->/g, '')
    .replace(/```[\s\S]*?```/g, '')

  for (const rawBlock of withoutComments.split(/\n{2,}/)) {
    const trimmed = rawBlock.trim()
    if (!trimmed)
      continue
    if (/^(?:import|export)\s+/.test(trimmed))
      continue
    if (/^#{1,6}\s+/.test(trimmed))
      continue
    if (/^>/.test(trimmed))
      continue
    if (/^[-*_]{3,}$/.test(trimmed))
      continue
    if (/^\|.*\|/.test(trimmed))
      continue
    if (/^<(?:figure|div|section|script|style|img)\b/i.test(trimmed))
      continue

    const text = stripInlineMarkdown(trimmed.replace(/^[-*+]\s+|^\d+\.\s+/gm, ''))
    if (!text)
      continue

    return text.length > maxLength ? `${text.slice(0, maxLength).trimEnd()}…` : text
  }

  return ''
}

function formatWordCount(words: number) {
  if (words >= 1000)
    return `${(words / 1000).toFixed(2).replace(/\.?0+$/, '')}k`
  return String(words)
}

const { post, class: className, headingLevel = 'h2', locale = defaultLocale } = Astro.props
const t = useTranslations(locale)
const { title, publishDate, excerpt, description, tags = [] } = post.data
const TitleTag = headingLevel
const postUrl = getPostUrl(post)
const coverImage = getPostCoverImage(post.data, title)
const uniqueTags = [...new Set(tags.map(tag => tag.trim()).filter(Boolean))]
const summary = excerpt?.trim() || description?.trim() || extractFirstParagraph(post.body)
const readingStats = getReadingStats(post.body)
const minutesRead = readingStats.minutesRead
const formattedWords = formatWordCount(readingStats.words)
---

<article class:list={['post-feed-item', className]}>
  <header class="feed-header">
    <TitleTag class:list={['feed-title', { 'feed-title--sub': headingLevel === 'h3' }]}>
      <a class="feed-title-link" href={postUrl}>{title}</a>
    </TitleTag>

    <div class="feed-date">
      <FormattedDate date={publishDate} locale={locale} />
    </div>

    {uniqueTags.length > 0 && (
      <div class="feed-tags" aria-label={locale === 'zh-CN' ? '文章标签' : 'Tags'}>
        {uniqueTags.map((tag, index) => (
          <>
            {index > 0 && <span class="feed-tag-sep" aria-hidden="true">|</span>}
            <span class="feed-tag">{tag}</span>
          </>
        ))}
      </div>
    )}
  </header>

  {coverImage && (
    <a class="feed-cover" href={postUrl} aria-label={t.post.coverAlt(title)} tabindex="-1">
      <img
        src={coverImage.src}
        alt={coverImage.alt}
        width={COVER_WIDTH}
        height={COVER_HEIGHT}
        loading="lazy"
        decoding="async"
      />
    </a>
  )}

  {summary && <p class="feed-excerpt">{summary}</p>}

  <footer class="feed-footer">
    <a class="feed-read-more" href={postUrl}>
      <span>{t.post.readPost}</span>
      <span class="feed-arrow" aria-hidden="true">→</span>
    </a>
    {readingStats.words > 0 && (
      <span class="feed-stats">
        {locale === 'zh-CN'
          ? `本文总计 ${formattedWords} 字，阅读约需要 ${minutesRead} 分钟`
          : `${formattedWords} words, about ${minutesRead} min read`}
      </span>
    )}
  </footer>
</article>

<style>
  .post-feed-item {
    width: 100%;
    padding-bottom: 2.5rem;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid rgb(var(--color-border-card) / 0.55);
  }

  .post-feed-item:last-child {
    padding-bottom: 0;
    margin-bottom: 0;
    border-bottom: none;
  }

  .feed-title {
    margin: 0;
    font-size: 1.65rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.015em;
    overflow-wrap: anywhere;
  }

  .feed-title--sub {
    font-size: 1.5rem;
  }

  .feed-title-link {
    color: rgb(var(--color-brand));
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.22em;
    transition: color 180ms ease, text-decoration-color 180ms ease;
  }

  .feed-title-link:hover {
    text-decoration-color: rgb(var(--color-brand) / 0.55);
  }

  .feed-title-link:focus-visible {
    outline: 2px solid rgb(var(--color-brand));
    outline-offset: 4px;
    border-radius: 2px;
  }

  .feed-date {
    margin-top: 0.55rem;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.5;
    color: rgb(var(--color-text-main) / 0.82);
    font-variant-numeric: tabular-nums;
  }

  .feed-tags {
    margin-top: 0.35rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    row-gap: 0.15rem;
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .feed-tag {
    color: rgb(var(--color-brand) / 0.82);
  }

  .feed-tag-sep {
    margin-inline: 0.45rem;
    color: rgb(var(--color-text-muted) / 0.5);
  }

  .feed-cover {
    display: block;
    margin-top: 1.15rem;
    overflow: hidden;
    border-radius: 0.5rem;
    border: 1px solid rgb(var(--color-border-card) / 0.45);
    background-color: rgb(var(--color-bg-muted) / 0.35);
    transition: border-color 200ms ease;
  }

  .feed-cover:hover {
    border-color: rgb(var(--color-border-card) / 0.9);
  }

  .feed-cover img {
    display: block;
    width: 100%;
    aspect-ratio: 1200 / 630;
    max-height: 340px;
    object-fit: cover;
    border-radius: 0;
    transition: transform 350ms cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  .feed-cover:hover img {
    transform: scale(1.015);
  }

  :global(html.dark) .feed-cover {
    background-color: rgb(var(--color-bg-card));
  }

  :global(html.dark) .feed-cover img {
    filter: brightness(0.9);
  }

  .feed-excerpt {
    margin-top: 1.1rem;
    margin-bottom: 0;
    font-size: 0.98rem;
    line-height: 1.8;
    color: rgb(var(--color-text-p));
    overflow-wrap: anywhere;
  }

  .feed-footer {
    margin-top: 0.85rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.65rem;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .feed-read-more {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: rgb(var(--color-brand) / 0.9);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1.25px;
    text-underline-offset: 0.22em;
    transition: color 180ms ease, text-decoration-color 180ms ease;
  }

  .feed-read-more:hover {
    color: rgb(var(--color-brand));
    text-decoration-color: rgb(var(--color-brand) / 0.55);
  }

  .feed-read-more:focus-visible {
    outline: 2px solid rgb(var(--color-brand));
    outline-offset: 3px;
    border-radius: 2px;
  }

  .feed-arrow {
    transition: transform 180ms ease;
  }

  .feed-read-more:hover .feed-arrow {
    transform: translateX(2px);
  }

  .feed-stats {
    color: rgb(var(--color-text-muted));
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 767px) {
    .post-feed-item {
      padding-bottom: 2rem;
      margin-bottom: 2rem;
    }

    .feed-title {
      font-size: 1.375rem;
    }

    .feed-title--sub {
      font-size: 1.25rem;
    }

    .feed-cover img {
      aspect-ratio: 16 / 9;
      max-height: 240px;
    }

    .feed-excerpt {
      font-size: 0.96rem;
      line-height: 1.75;
    }
  }
</style>
