---
const {
  replayLabel = '重新播放',
  imageLabel = '玫瑰照片逐格显现的加载动画',
} = Astro.props
---

<div class="load-demo-wrapper not-prose" data-load-demo>
  <div class="load-demo" role="img" aria-label={imageLabel}></div>
  <button class="replay-button" type="button" data-replay>{replayLabel}</button>
</div>

<style>
  .load-demo-wrapper {
    width: min(100%, 560px);
  }

  .load-demo {
    width: 100%;
    aspect-ratio: 3 / 2;
    background: #829cb7 url('https://mongorolls-images.oss-cn-shenzhen.aliyuncs.com/blog/26-01-30-share/share.jpg') center / cover no-repeat;
    mask-image: linear-gradient(#000 0 0);
    mask-size: 0% 100%;
    mask-position: left center;
    mask-repeat: no-repeat;
    animation: reveal 1.8s steps(25, end) forwards;
  }

  .replay-button {
    margin-top: 12px;
    padding: 7px 14px;
    border: 1px solid rgb(var(--color-border-card));
    border-radius: 999px;
    background: rgb(var(--color-bg-card));
    color: rgb(var(--color-text-main));
    font: inherit;
    font-size: 14px;
    cursor: pointer;
  }

  .replay-button:hover {
    border-color: rgb(var(--color-brand));
    color: rgb(var(--color-brand));
  }

  .replay-button:focus-visible {
    outline: 2px solid rgb(var(--color-brand));
    outline-offset: 3px;
  }

  @keyframes reveal {
    to { mask-size: 100% 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .load-demo { animation: none; mask-size: 100% 100%; }
    .replay-button { display: none; }
  }
</style>

<script>
  function initLoadDemos() {
    document.querySelectorAll<HTMLElement>('[data-load-demo]').forEach((wrapper) => {
      if (wrapper.dataset.ready)
        return
      wrapper.dataset.ready = 'true'

      const image = wrapper.querySelector<HTMLElement>('.load-demo')!
      const button = wrapper.querySelector<HTMLButtonElement>('[data-replay]')!

      button.addEventListener('click', () => {
        image.getAnimations().forEach((animation) => {
          animation.currentTime = 0
          animation.play()
        })
      })
    })
  }

  initLoadDemos()
  document.addEventListener('astro:page-load', initLoadDemos)
</script>
