---
interface Props { text: string }
const { text } = Astro.props
const textLength = Array.from(text).length
---

<button type="button" class="typing" aria-pressed="false" style={`--textLength: ${textLength}`}>{text}</button>

<style>
.typing {
  font-family: monospace;
  font-size: 32px;
  display: inline-block;
  white-space: nowrap;
  overflow: hidden;
  border-right: 3px solid currentColor;
  vertical-align: middle;
  cursor: pointer;
}

.typing:focus-visible {
  outline: 2px solid currentColor;
  outline-offset: 4px;
}

.typing-active {
  animation: typing 4s steps(var(--textLength), end), blink 0.75s step-end infinite;
}

@keyframes typing {
  from { width: 0; }
  to { width: calc(var(--textLength) * 1ch + 4px); }
}

@keyframes blink {
  from, to { border-color: transparent; }
  50% { border-color: currentColor; }
}

@media (prefers-reduced-motion: reduce) {
  .typing-active { animation: none; }
}
</style>

<script>
let disposeTyping = () => {}

function initTyping() {
  disposeTyping()
  const controller = new AbortController()
  document.querySelectorAll<HTMLButtonElement>('.typing').forEach((typing) => {
    typing.addEventListener('click', () => {
      const active = typing.classList.toggle('typing-active')
      typing.setAttribute('aria-pressed', String(active))
    }, { signal: controller.signal })
  })
  disposeTyping = () => controller.abort()
}

document.addEventListener('astro:page-load', initTyping)
document.addEventListener('astro:before-swap', () => disposeTyping())
</script>
