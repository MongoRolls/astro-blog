<div class="card-container not-prose" data-card-demo>
  <div class="card" role="img" aria-label="可随鼠标倾斜的星空卡片">
    <div class="card-orbit"></div>
    <div class="card-planet"></div>
    <div class="card-caption">
      <span>NO. 001 / COSMOS</span>
      <strong>星际漫游</strong>
      <span>HOLOGRAPHIC EDITION</span>
    </div>
  </div>
</div>

<style>
  .card-container {
    width: min(100%, 260px);
    perspective: 800px;
  }

  .card {
    --pointer-x: 50%;
    --pointer-y: 50%;
    position: relative;
    aspect-ratio: 143 / 200;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 55%);
    border-radius: 18px;
    background:
      radial-gradient(circle at 20% 22%, #f8a5ca 0, transparent 24%),
      radial-gradient(circle at 80% 72%, #5071cc 0, transparent 32%),
      linear-gradient(145deg, #29336f, #171b42 58%, #382052);
    box-shadow: 0 18px 34px rgb(28 30 67 / 25%), inset 0 0 0 6px rgb(255 255 255 / 12%);
    transform-style: preserve-3d;
    transition: transform 300ms ease, box-shadow 300ms ease;
    will-change: transform;
  }

  .card::before,
  .card::after {
    position: absolute;
    inset: 0;
    content: '';
    pointer-events: none;
  }

  .card::before {
    z-index: 2;
    background: radial-gradient(circle at var(--pointer-x) var(--pointer-y), rgb(255 255 255 / 70%), transparent 42%);
    mix-blend-mode: color-dodge;
    opacity: 0;
    transition: opacity 300ms ease;
  }

  .card::after {
    background-image: radial-gradient(#fff 1px, transparent 1.5px), radial-gradient(#b6e6ff 1px, transparent 1.5px);
    background-size: 37px 41px, 53px 59px;
    background-position: 3px 7px, 21px 29px;
    opacity: .7;
  }

  .card-container:hover .card::before { opacity: 1; }

  .card-orbit {
    position: absolute;
    inset: 15% -36%;
    border: 2px solid rgb(255 225 194 / 65%);
    border-radius: 50%;
    transform: rotate(-30deg) translateZ(25px);
  }

  .card-planet {
    position: absolute;
    top: 22%;
    left: 17%;
    width: 66%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 28% 25%, #fff7dc, #f8ae9a 30%, #a94891 68%, #442870 100%);
    box-shadow: 0 0 42px rgb(255 183 185 / 65%);
    transform: translateZ(36px);
  }

  .card-caption {
    position: absolute;
    z-index: 1;
    inset: auto 22px 22px;
    display: grid;
    gap: 4px;
    color: #fff;
    text-shadow: 0 2px 8px rgb(0 0 0 / 55%);
    transform: translateZ(42px);
  }

  .card-caption span { font: 10px/1.4 monospace; letter-spacing: .12em; }
  .card-caption strong { font: 700 27px/1.2 serif; letter-spacing: .08em; }

  @media (prefers-reduced-motion: reduce) {
    .card { transition: none; will-change: auto; }
    .card::before { transition: none; }
  }
</style>

<script>
  function initCards() {
    document.querySelectorAll<HTMLElement>('[data-card-demo]').forEach((container) => {
      if (container.dataset.ready)
        return
      container.dataset.ready = 'true'

      const card = container.querySelector<HTMLElement>('.card')!
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')

      container.addEventListener('pointermove', (event) => {
        if (reducedMotion.matches)
          return
        const rect = card.getBoundingClientRect()
        const x = (event.clientX - rect.left) / rect.width
        const y = (event.clientY - rect.top) / rect.height
        card.style.setProperty('--pointer-x', `${x * 100}%`)
        card.style.setProperty('--pointer-y', `${y * 100}%`)
        card.style.transform = `rotateX(${(0.5 - y) * 18}deg) rotateY(${(x - 0.5) * 18}deg)`
      })

      container.addEventListener('pointerleave', () => {
        card.style.transform = ''
        card.style.removeProperty('--pointer-x')
        card.style.removeProperty('--pointer-y')
      })
    })
  }

  initCards()
  document.addEventListener('astro:page-load', initCards)
</script>
