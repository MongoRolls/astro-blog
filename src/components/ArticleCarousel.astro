---
import type { CollectionEntry } from 'astro:content'
import type { Locale } from '../i18n/config'
import { getPostCoverSrc } from '../config/image'
import { defaultLocale } from '../i18n/config'
import { getPostUrl } from '../utils/data-utils'

type Props = {
    posts: CollectionEntry<'blog'>[]
    locale?: Locale
}

const { posts, locale = defaultLocale } = Astro.props;

---

<div class="carousel-container">
    <div class="carousel-wrapper">
        {posts.map((post, index) => (
            <div class:list={['carousel-slide', { 'active': index === 0, 'pointer-events-none': index !== 0 }]} aria-hidden={index !== 0 ? 'true' : 'false'}>
                <a class="carousel-link" href={getPostUrl(post)} aria-label={post.data.title} tabindex={index === 0 ? undefined : -1}>
                    <img
                      src={getPostCoverSrc(post.data)}
                      alt={post.data.title}
                      class="carousel-image"
                      loading="lazy"
                    />
                    <div class="carousel-overlay">
                        <h3 class="carousel-title">{post.data.title}</h3>
                        {(post.data.excerpt ?? post.data.description) && <p class="carousel-excerpt">{post.data.excerpt ?? post.data.description}</p>}
                    </div>
                </a>
            </div>
        ))}
    </div>
    {posts.length > 1 && (
        <div class="carousel-dots">
            {posts.map((_, index) => (
                <button class:list={['carousel-dot', { active: index === 0 }]} type="button" data-index={index} aria-current={index === 0 ? 'true' : 'false'} aria-label={locale === 'zh-CN' ? `显示第 ${index + 1} 篇文章` : `Show post ${index + 1}`}></button>
            ))}
        </div>
    )}
</div>

<style>
    .carousel-container {
        position: relative;
        width: 100%;
        height: 300px;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    }

    .carousel-wrapper {
        position: relative;
        width: 100%;
        height: 100%;
    }

    .carousel-slide {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        transition: opacity 0.5s ease;
    }

    .carousel-slide.active {
        opacity: 1;
    }

    .carousel-slide.pointer-events-none {
        pointer-events: none;
    }

    .carousel-link {
        display: block;
        width: 100%;
        height: 100%;
        position: relative;
        text-decoration: none;
        color: inherit;
    }

    .carousel-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .carousel-link:hover .carousel-image {
        transform: scale(1.05);
    }

    .carousel-link:focus-visible {
        outline: 3px solid rgb(var(--color-primary));
        outline-offset: -3px;
    }

    .carousel-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        background: linear-gradient(transparent, rgba(0, 0, 0, 0.8));
        padding: 30px 20px 56px;
        color: white;
    }

    .carousel-title {
        font-size: 1.25rem;
        font-weight: 600;
        margin: 0 0 8px 0;
        line-height: 1.3;
        font-family: serif;
    }

    .carousel-excerpt {
        font-size: 0.875rem;
        margin: 0;
        opacity: 0.9;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .carousel-dots {
        position: absolute;
        bottom: 4px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 0;
        z-index: 10;
    }

    .carousel-dot {
        display: grid;
        place-items: center;
        width: 44px;
        height: 44px;
        border: none;
        background: transparent;
        cursor: pointer;
    }

    .carousel-dot::before {
        content: '';
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.5);
        transition: background-color 0.3s ease;
    }

    .carousel-dot.active::before {
        background: white;
    }

    .carousel-dot:focus-visible {
        outline: 2px solid white;
        outline-offset: -5px;
        border-radius: 50%;
    }

    @media (max-width: 767px) {
        .carousel-container {
            height: 280px;
        }

        .carousel-title {
            font-size: 1.1rem;
            line-height: 1.45;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .carousel-excerpt {
            font-size: 0.875rem;
            line-height: 1.6;
            -webkit-line-clamp: 2;
        }

        .carousel-overlay {
            padding: 28px 16px 56px;
        }
    }
</style>

<script>
  let disposeCarousel = () => {}

  document.addEventListener('astro:page-load', () => {
    disposeCarousel()

    const container = document.querySelector<HTMLElement>('.carousel-container')
    if (!container)
      return

    const controller = new AbortController()
    const slides = document.querySelectorAll('.carousel-slide')
    const dots = document.querySelectorAll('.carousel-dot')
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
    let currentSlide = 0
    let autoPlayInterval: ReturnType<typeof setInterval> | undefined

    function showSlide(index: number) {
      slides.forEach((slide, i) => {
        slide.classList.toggle('active', i === index)
        slide.classList.toggle('pointer-events-none', i !== index)
        slide.setAttribute('aria-hidden', i === index ? 'false' : 'true')
        slide.querySelector('a')?.setAttribute('tabindex', i === index ? '0' : '-1')
      })
      dots.forEach((dot, i) => {
        dot.classList.toggle('active', i === index)
        dot.setAttribute('aria-current', i === index ? 'true' : 'false')
      })
    }

    function nextSlide() {
      currentSlide = (currentSlide + 1) % slides.length
      showSlide(currentSlide)
    }

    function startAutoPlay() {
      if (slides.length <= 1 || reducedMotion.matches || document.hidden
        || container?.matches(':hover') || container?.contains(document.activeElement) || autoPlayInterval) {
        return
      }
      autoPlayInterval = setInterval(nextSlide, 4000)
    }

    function stopAutoPlay() {
      if (autoPlayInterval) {
        clearInterval(autoPlayInterval)
        autoPlayInterval = undefined
      }
    }

    // 初始化
    if (slides.length > 0) {
      showSlide(0)
      startAutoPlay()

      // 点击控制
      dots.forEach((dot, index) => {
        dot.addEventListener('click', () => {
          currentSlide = index
          showSlide(currentSlide)
          stopAutoPlay()
          startAutoPlay()
        }, { signal: controller.signal })
      })

      // 鼠标悬停暂停自动播放
      container.addEventListener('mouseenter', stopAutoPlay, { signal: controller.signal })
      container.addEventListener('mouseleave', startAutoPlay, { signal: controller.signal })
      container.addEventListener('focusin', stopAutoPlay, { signal: controller.signal })
      container.addEventListener('focusout', (event) => {
        if (!(event.relatedTarget instanceof Node) || !container.contains(event.relatedTarget))
          startAutoPlay()
      }, { signal: controller.signal })
      document.addEventListener('visibilitychange', () => {
        if (document.hidden)
          stopAutoPlay()
        else
          startAutoPlay()
      }, { signal: controller.signal })
      reducedMotion.addEventListener('change', () => {
        if (reducedMotion.matches)
          stopAutoPlay()
        else
          startAutoPlay()
      }, { signal: controller.signal })
    }

    disposeCarousel = () => {
      controller.abort()
      stopAutoPlay()
    }
  })

  document.addEventListener('astro:before-swap', () => disposeCarousel())
</script>
