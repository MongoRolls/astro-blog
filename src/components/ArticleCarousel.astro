---
import type { CollectionEntry } from 'astro:content'
import { getPostCoverSrc } from '../config/image'

type Props = {
    posts: CollectionEntry<'blog'>[]
}

const { posts } = Astro.props;

---

<div class="carousel-container">
    <div class="carousel-wrapper">
        {posts.map(post => (
            <div class="carousel-slide">
                <a class="carousel-link" href={`/blog/${post.id}`} aria-label={post.data.title}>
                    <img
                      src={getPostCoverSrc(post.data)}
                      alt={post.data.title}
                      class="carousel-image"
                      loading="lazy"
                    />
                    <div class="carousel-overlay">
                        <h3 class="carousel-title">{post.data.title}</h3>
                        {(post.data.excerpt ?? post.data.description) && <p class="carousel-excerpt">{post.data.excerpt ?? post.data.description}</p>}
                    </div>
                </a>
            </div>
        ))}
    </div>
    <div class="carousel-dots">
        {posts.map((_, index) => (
            <button class="carousel-dot" data-index={index} aria-label={`显示第 ${index + 1} 篇文章`}></button>
        ))}
    </div>
</div>

<style>
    .carousel-container {
        position: relative;
        width: 100%;
        height: 300px;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    }

    .carousel-wrapper {
        position: relative;
        width: 100%;
        height: 100%;
    }

    .carousel-slide {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        transition: opacity 0.5s ease;
    }

    .carousel-slide.active {
        opacity: 1;
    }

    .carousel-slide.pointer-events-none {
        pointer-events: none;
    }

    .carousel-link {
        display: block;
        width: 100%;
        height: 100%;
        position: relative;
        text-decoration: none;
        color: inherit;
    }

    .carousel-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .carousel-link:hover .carousel-image {
        transform: scale(1.05);
    }

    .carousel-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        background: linear-gradient(transparent, rgba(0, 0, 0, 0.8));
        padding: 30px 20px 20px;
        color: white;
    }

    .carousel-title {
        font-size: 1.25rem;
        font-weight: 600;
        margin: 0 0 8px 0;
        line-height: 1.3;
        font-family: serif;
    }

    .carousel-excerpt {
        font-size: 0.875rem;
        margin: 0;
        opacity: 0.9;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .carousel-dots {
        position: absolute;
        bottom: 15px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 8px;
        z-index: 10;
    }

    .carousel-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        border: none;
        background: rgba(255, 255, 255, 0.5);
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

    .carousel-dot.active {
        background: white;
    }

    @media (max-width: 768px) {
        .carousel-container {
            height: 250px;
        }

        .carousel-title {
            font-size: 1.1rem;
        }

        .carousel-excerpt {
            font-size: 0.8rem;
            -webkit-line-clamp: 1;
        }

        .carousel-overlay {
            padding: 20px 15px 15px;
        }
    }
</style>

<script>
  let disposeCarousel = () => {}

  document.addEventListener('astro:page-load', () => {
    disposeCarousel()

    const container = document.querySelector<HTMLElement>('.carousel-container')
    if (!container)
      return

    const controller = new AbortController()
    const slides = document.querySelectorAll('.carousel-slide')
    const dots = document.querySelectorAll('.carousel-dot')
    let currentSlide = 0
    let autoPlayInterval: ReturnType<typeof setInterval> | undefined

    function showSlide(index: number) {
      slides.forEach((slide, i) => {
        slide.classList.toggle('active', i === index)
        slide.classList.toggle('pointer-events-none', i !== index)
      })
      dots.forEach((dot, i) => {
        dot.classList.toggle('active', i === index)
        dot.setAttribute('aria-current', i === index ? 'true' : 'false')
      })
    }

    function nextSlide() {
      currentSlide = (currentSlide + 1) % slides.length
      showSlide(currentSlide)
    }

    function startAutoPlay() {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || autoPlayInterval)
        return
      autoPlayInterval = setInterval(nextSlide, 4000)
    }

    function stopAutoPlay() {
      if (autoPlayInterval) {
        clearInterval(autoPlayInterval)
        autoPlayInterval = undefined
      }
    }

    // 初始化
    if (slides.length > 0) {
      showSlide(0)
      startAutoPlay()

      // 点击控制
      dots.forEach((dot, index) => {
        dot.addEventListener('click', () => {
          currentSlide = index
          showSlide(currentSlide)
          stopAutoPlay()
          startAutoPlay()
        }, { signal: controller.signal })
      })

      // 鼠标悬停暂停自动播放
      container.addEventListener('mouseenter', stopAutoPlay, { signal: controller.signal })
      container.addEventListener('mouseleave', startAutoPlay, { signal: controller.signal })
    }

    disposeCarousel = () => {
      controller.abort()
      stopAutoPlay()
    }
  })

  document.addEventListener('astro:before-swap', () => disposeCarousel())
</script>
