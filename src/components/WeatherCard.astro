---
import type { Locale } from '../i18n/config'
import client from '../scripts/weather-card.js?raw'

type Props = { locale?: Locale, standalone?: boolean }
const { locale = 'zh-CN', standalone = false } = Astro.props
const title = locale === 'en' ? 'Local weather' : '本地天气'
---

<blog-weather lang={locale} data-standalone={standalone || undefined} role="region" aria-label={title}>
  <div class="weather-reading" aria-live="polite" aria-atomic="true">
    <div class="weather-current">
      <p class="weather-temperature" data-temperature hidden></p>
      <div class="weather-location">
        <h2 data-place>{title}</h2>
        <p class="weather-condition">
          <span class="weather-symbol" aria-hidden="true"></span>
          <span data-condition>{locale === 'en' ? 'Weather unavailable' : '天气暂不可用'}</span>
        </p>
      </div>
    </div>
    <div class="weather-meta">
      <p data-detail hidden></p>
      <a class="weather-credit" href="https://open-meteo.com/" hidden>Open-Meteo · CC BY 4.0 ↗</a>
    </div>
  </div>
</blog-weather>

<script is:inline type="module" set:html={client} />

<style is:inline>
  blog-weather {
    --glass-sheen: rgb(255 255 255 / .76);
    --glass-edge: rgb(0 0 0 / .14);
    display: block;
    container-type: inline-size;
    box-sizing: border-box;
    width: 100%;
    margin-block-end: 2rem;
    padding: 1rem clamp(1rem, 4vw, 1.5rem);
    border: 1px solid var(--glass-edge);
    border-radius: 1.25rem;
    background: linear-gradient(140deg, var(--glass-sheen), rgb(255 255 255 / .08));
    backdrop-filter: grayscale(1) blur(7px);
    box-shadow: inset 0 1px 0 var(--glass-sheen), 0 3px 12px rgb(0 0 0 / .06);
    color: #242424;
    font: 1rem/1.4 Inter, -apple-system, BlinkMacSystemFont, sans-serif;
  }
  .dark blog-weather {
    --glass-sheen: rgb(255 255 255 / .16);
    --glass-edge: rgb(255 255 255 / .24);
    color: #fafafa;
  }
  blog-weather .weather-reading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: .75rem 1.25rem;
    overflow-wrap: anywhere;
  }
  blog-weather .weather-current, blog-weather .weather-condition {
    display: flex;
    align-items: center;
    gap: .85rem;
  }
  blog-weather .weather-condition { gap: .35rem; }
  blog-weather h2, blog-weather p { margin: 0; }
  blog-weather h2 { font: inherit; font-weight: 600; }
  blog-weather .weather-temperature {
    flex: none;
    font-size: clamp(2rem, 6vw, 2.85rem);
    font-weight: 350;
    line-height: 1;
    letter-spacing: -.045em;
  }
  blog-weather .weather-location { min-width: 0; }
  blog-weather .weather-symbol { font: 1.2em/1 Georgia, serif; }
  blog-weather .weather-meta {
    padding-inline-start: 1.25rem;
    border-inline-start: 1px solid var(--glass-edge);
    font-size: .82rem;
  }
  blog-weather .weather-credit { color: inherit; text-underline-offset: .18em; text-decoration: underline; }
  blog-weather .weather-credit:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  blog-weather [hidden], blog-weather .weather-symbol:empty,
  blog-weather .weather-meta:has([data-detail][hidden]) { display: none; }
  blog-weather .weather-reading:has([data-temperature][hidden]) { grid-template-columns: 1fr; }
  blog-weather [data-temperature][hidden] + .weather-location {
    display: flex;
    width: 100%;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: .25rem .75rem;
  }
  @container (max-width: 28rem) {
    blog-weather .weather-reading { grid-template-columns: 1fr; }
    blog-weather .weather-meta { border: 0; border-block-start: 1px solid var(--glass-edge); padding: .6rem 0 0; }
  }
  @media (forced-colors: active) {
    blog-weather { border-color: CanvasText; }
  }
</style>
