---
const techStacks = [
  { name: 'HTML', icon: '/tech/html.svg', bg: 'bg-red-200' },
  { name: 'CSS', icon: '/tech/css.svg', bg: 'bg-sky-200' },
  { name: 'JavaScript', icon: '/tech/js.webp', bg: 'bg-yellow-300' },
  { name: 'Git', icon: '/tech/git.svg', bg: 'bg-red-400' },
  { name: 'React', icon: '/tech/react.svg', bg: 'bg-slate-200' },
  { name: 'Tailwind', icon: '/tech/tailwind.svg', bg: 'bg-slate-200' },
  { name: 'ESLint', icon: '/tech/eslint.svg', bg: 'bg-indigo-200' },
  { name: 'Python', icon: '/tech/python.svg', bg: 'bg-yellow-100' },
  { name: 'Vue', icon: '/tech/vue.svg', bg: 'bg-emerald-200' },
]

// 复制一份实现无缝滚动
const allTechStacks = [...techStacks, ...techStacks];
---

<div class="tech-stack-panel w-full p-4 rounded-xl">
  <div class="tech-stack-viewport overflow-hidden relative">
    <div id="tech-stack" class="tech-stack-track flex gap-4 animate-scroll">
      {
        allTechStacks.map((tech, index) => (
          <div class={`tech-stack-item flex justify-center items-center flex-shrink-0 w-20 h-20 p-4 rounded-lg ${tech.bg}`} aria-hidden={index >= techStacks.length ? 'true' : undefined}>
            <img
              src={tech.icon}
              alt={tech.name}
              class="w-full h-full object-contain"
              loading="lazy"
              decoding="async"
            />
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  .tech-stack-panel {
    background-color: rgb(var(--color-bg-muted) / 0.35);
    border: 1px solid rgb(var(--color-border-card) / 0.8);
    transition: background-color 300ms ease, border-color 300ms ease;
  }

  :global(html.dark) .tech-stack-panel {
    background-color: rgb(var(--color-bg-card));
    border-color: rgb(var(--color-border-card) / 0.85);
  }

  .tech-stack-viewport {
    mask-image: linear-gradient(to right, transparent, black 1.5rem, black calc(100% - 1.5rem), transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 1.5rem, black calc(100% - 1.5rem), transparent);
  }

  :global(html.dark) .tech-stack-item {
    filter: brightness(0.92);
  }

  .tech-stack-track {
    width: max-content;
  }

  .animate-scroll {
    animation: scroll 20s linear infinite;
    will-change: transform;
  }

  .animate-scroll > div {
    transform: translateZ(0);
  }

  @keyframes scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-50% - 0.5rem));
    }
  }

  /* 鼠标悬停时暂停动画 */
  .tech-stack-panel:hover .animate-scroll {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .tech-stack-viewport {
      mask-image: none;
      -webkit-mask-image: none;
      overflow-x: auto;
    }

    .animate-scroll {
      animation: none;
    }

    .tech-stack-item[aria-hidden='true'] {
      display: none;
    }
  }
</style>
