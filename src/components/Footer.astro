---
import siteConfig from '../data/site-config';

const socialLinks = siteConfig.socialLinks || [];
const navLinks = siteConfig.footerNavLinks || [];
---

<footer class="w-full max-w-3xl mx-auto pt-12 pb-10 sm:pt-24 sm:pb-14">
    {
        (navLinks.length > 0 || socialLinks.length > 0) && (
            <div class="mb-4 flex flex-wrap gap-x-6 gap-y-1 max-md:justify-center">
                {navLinks?.map((link) => (
                    <a class="font-serif hover:underline hover:underline-offset-2" href={link.href}>
                        {link.text}
                    </a>
                ))}
                 {socialLinks?.map((link) => (
                        <a
                            class="font-serif hover:underline hover:underline-offset-2"
                            href={link.href}
                            target="_blank"
                            rel="noopener noreferer"
                        >
                            {link.text}
                        </a>
                    ))}
            </div>
        )
    }
    <div class="pt-6 flex flex-col gap-4 border-t border-dashed border-main" />
    <p class="text-sm md:text-left max-md:text-center">
        &copy; {new Date().getFullYear()}&nbsp; All rights reserved.
    </p>
</footer>
