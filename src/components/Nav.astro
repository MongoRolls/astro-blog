---
import type { Locale } from '../i18n/config'
import { getSiteConfig } from '../data/site-config'
import { defaultLocale, localizedPath } from '../i18n/config'
import { useTranslations } from '../i18n/ui'
import AnimatedSignature from './AnimatedSignature.astro'
import LanguageToggle from './LanguageToggle.astro'
import NavLink from './NavLink.astro'
import Search from './Search.astro'
import ThemeToggle from './ThemeToggle.astro'

type Props = { locale?: Locale, languageUrl: string, exactLanguageMatch?: boolean }
const { locale = defaultLocale, languageUrl, exactLanguageMatch = true } = Astro.props
const t = useTranslations(locale)
const navLinks = getSiteConfig(locale).headerNavLinks || [];
---

<nav data-pagefind-ignore class="nav" aria-label={t.nav.navigation}>
    {
            navLinks.length > 0 && (
            <div class="nav-inner">
                <div class="flex items-center justify-between w-full">
                    <div class="flex items-center">
                        <button
                          class="menu-toggle w-11 h-11 flex items-center justify-center relative z-30 md:hidden mr-3 rounded-full hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
                          type="button"
                          aria-label={t.nav.openMenu}
                          aria-expanded="false"
                          aria-controls="menu-items"
                          data-label-open={t.nav.openMenu}
                          data-label-close={t.nav.closeMenu}
                        >
                            <span class="menu-toggle-icon w-6 h-px relative bg-current" />
                        </button>

                        <ul id="menu-items" class="menu flex items-center gap-1">
                            <li class="flex items-center"><a href={localizedPath(locale, '/')} aria-label={t.nav.home}>
                            {/* 红色 bb3a46 */}
                            <AnimatedSignature
                              width="105px"
                              height="45px"
                              animationDuration="18s"
                              strokeColor="#425bc5"
                              darkStrokeColor="rgb(var(--color-brand))"
                              darkFillColor="rgb(var(--color-brand))"
                              fillColor="#425bc5"
                              strokeWidth={12}
                              delayInterval={0.2}
                            />
                            </a></li>
                            {navLinks.map(link => (
                                <li class="nav-item py-1">
                                    <NavLink
                                      class="nav-link font-serif text-main"
                                      href={link.href}
                                    >
                                        {link.text}
                                    </NavLink>
                                </li>
                            ))}
                        </ul>
                    </div>

                    <div class="nav-actions flex items-center gap-0.5">
                        <Search locale={locale} />
                        <LanguageToggle locale={locale} href={languageUrl} exactMatch={exactLanguageMatch} />
                        <ThemeToggle locale={locale} />
                    </div>
                </div>
            </div>
        )
    }
</nav>

<style lang="scss">
    @reference "../styles/global.css";

    @media (max-width: 767px) {
        /* 移动端菜单 */
        .menu {
            @apply flex-col items-stretch gap-1 absolute top-full left-1/2 mt-3 px-2 py-2 bg-main border border-main/10 invisible opacity-0 rounded-xl;
            width: min(20rem, calc(100vw - 2rem));
            margin-left: 0;
            translate: -50% 0;
            z-index: 20;
            box-shadow: var(--card-shadow);
            transform: translateY(-0.5rem) scale(0.98);
            transform-origin: top center;
            transition:
                opacity 0.18s ease,
                transform 0.18s ease,
                visibility 0s linear 0.18s;
        }
        .menu > li:first-child {
            display: none;
        }
        .menu .nav-item {
            width: 100%;
            padding: 0;
        }
        .menu .nav-link {
            display: block;
            width: 100%;
            padding: 0.55rem 0.75rem;
            border-radius: 0.5rem;
            transition: color 0.15s ease, background-color 0.15s ease;
        }
        .menu .nav-link:hover,
        .menu .nav-link:focus-visible {
            color: rgb(var(--color-primary));
            background: rgb(var(--color-text-main) / 0.07);
            outline: none;
        }
        .menu.is-visible {
            @apply visible opacity-100;
            transform: translateY(0) scale(1);
            transition:
                opacity 0.18s ease,
                transform 0.18s ease,
                visibility 0s;
        }
        .menu-toggle-icon {
            transition: width 0.1s cubic-bezier(0.4, 0, 0.2, 1) 0.3s;
        }
        .menu-toggle.is-active .menu-toggle-icon {
            @apply w-0;
            transition: width 0.1s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .menu-toggle-icon:before,
        .menu-toggle-icon:after {
            @apply w-6 h-px absolute left-1/2 top-0 origin-center -translate-x-1/2 bg-current;
            content: '';
            transition:
                transform 0.2s cubic-bezier(0.4, 0, 0.2, 1),
                margin 0.2s cubic-bezier(0.4, 0, 0.2, 1) 0.2s;
        }
        .menu-toggle-icon:before {
            @apply -mt-1.5;
        }
        .menu-toggle-icon:after {
            @apply mt-1.5;
        }
        .menu-toggle.is-active .menu-toggle-icon:before,
        .menu-toggle.is-active .menu-toggle-icon:after {
            @apply mt-0;
            transition:
                margin 0.2s cubic-bezier(0.4, 0, 0.2, 1) 0.1s,
                transform 0.2s cubic-bezier(0.4, 0, 0.2, 1) 0.3s;
        }
        .menu-toggle.is-active .menu-toggle-icon:before {
            @apply rotate-45;
        }
        .menu-toggle.is-active .menu-toggle-icon:after {
            @apply -rotate-45;
        }
    }

    .nav {
        position: fixed;
        top: calc(1rem + env(safe-area-inset-top, 0px));
        left: 0;
        right: 0;
        width: fit-content;
        max-width: calc(100% - 2.5rem);
        margin-inline: auto;
        z-index: 9999;
        border-radius: 999px;
    }

    /* Keep the glass on a separate layer so the search dialog stays viewport-fixed. */
    .nav::before {
        content: '';
        position: absolute;
        inset: 0;
        z-index: -1;
        border-radius: inherit;
        border: 1px solid rgb(255 255 255 / 0.65);
        background: linear-gradient(135deg, rgb(var(--color-bg-main) / 0.4), rgb(var(--color-bg-main) / 0.16) 55%, rgb(var(--color-bg-main) / 0.3));
        backdrop-filter: blur(18px) saturate(190%);
        -webkit-backdrop-filter: blur(18px) saturate(190%);
        box-shadow: inset 0 1px 1px rgb(255 255 255 / 0.85),
            inset 0 -1px 1px rgb(var(--color-text-main) / 0.05),
            0 0 0 1px rgb(var(--color-text-main) / 0.04),
            0 6px 24px rgb(0 0 0 / 0.07), 0 2px 5px rgb(0 0 0 / 0.025);
        pointer-events: none;
    }

    :global(.dark) .nav::before {
        border-color: rgb(var(--color-text-main) / 0.2);
        background: linear-gradient(135deg, rgb(var(--color-bg-card) / 0.58), rgb(var(--color-bg-main) / 0.28) 55%, rgb(var(--color-bg-card) / 0.42));
        box-shadow: inset 0 1px 1px rgb(255 255 255 / 0.2), 0 6px 24px rgb(0 0 0 / 0.22);
    }

    .nav-inner {
        padding: 0.375rem 0.625rem;
    }

    .menu > li:first-child {
        margin-inline: 0.5rem 0.5rem;
    }

    .menu :global(.nav-link) {
        display: block;
        padding: 0.625rem 0.65rem;
        border-radius: 999px;
        font-size: 1rem;
        white-space: nowrap;
        transition: background-color 150ms ease;
    }

    .menu :global(.nav-link:hover),
    .menu :global(.nav-link[aria-current="page"]) {
        background: var(--link-bg-hover);
    }

    .menu :global(a:focus-visible) {
        outline: 2px solid currentColor;
        outline-offset: 2px;
    }

    .nav-actions {
        margin-left: 0.75rem;
        padding-left: 0.75rem;
        border-left: 1px solid rgb(var(--color-text-main) / 0.12);
    }

    @media (max-width: 767px) {
        .nav-inner { padding: 0.375rem; }
        .menu-toggle { margin-right: 0; }
        .nav-actions { margin-left: 0.375rem; padding-left: 0.375rem; }
        .menu { max-height: calc(100dvh - 7rem); overflow-y: auto; }
    }

    @supports not (backdrop-filter: blur(1px)) {
        .nav::before { background: rgb(var(--color-bg-main) / 0.96); }
    }

    .nav-actions :global(.nav-action) {
        position: relative;
        display: inline-flex;
        flex: 0 0 auto;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        padding: 0;
        border: 0;
        border-radius: 50%;
        color: rgb(var(--color-text-main));
        background: transparent;
        cursor: pointer;
        transition: background-color 150ms ease;
    }

    .nav-actions :global(.nav-action:hover) {
        background: var(--link-bg-hover);
    }

    .nav-actions :global(.nav-action:active) {
        background: var(--link-bg-active);
    }

    .nav-actions :global(.nav-action:focus-visible) {
        outline: 2px solid currentColor;
        outline-offset: 2px;
    }

    .nav-actions :global(.nav-action > svg) {
        width: 20px;
        height: 20px;
    }

    @media (max-width: 767px) {
        .nav-actions :global(.nav-action) {
            width: 44px;
            height: 44px;
        }
    }
</style>

<script>
let disposeNavigation = () => {}

function initNavigation() {
  disposeNavigation()
  const controller = new AbortController()
  const menu = document.querySelector<HTMLElement>('.menu')
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle')
  if (!menu || !toggle)
    return

  const setOpen = (isOpen: boolean) => {
    const openLabel = toggle.dataset.labelOpen ?? 'Open menu'
    const closeLabel = toggle.dataset.labelClose ?? 'Close menu'
    toggle.classList.toggle('is-active', isOpen)
    toggle.setAttribute('aria-expanded', String(isOpen))
    toggle.setAttribute('aria-label', isOpen ? closeLabel : openLabel)
    menu.classList.toggle('is-visible', isOpen)
  }

  toggle.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true')
  }, { signal: controller.signal })

  document.addEventListener('click', (event) => {
    const target = event.target
    if (
      toggle.getAttribute('aria-expanded') === 'true'
      && target instanceof Node
      && !menu.contains(target)
      && !toggle.contains(target)
    ) {
      setOpen(false)
    }
  }, { signal: controller.signal })

  menu.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setOpen(false), { signal: controller.signal })
  })

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
      setOpen(false)
      toggle.focus()
    }
  }, { signal: controller.signal })

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 768) {
      setOpen(false)
    }
  }, { signal: controller.signal })

  disposeNavigation = () => controller.abort()
}

document.addEventListener('astro:page-load', initNavigation)
document.addEventListener('astro:before-swap', () => disposeNavigation())
</script>
