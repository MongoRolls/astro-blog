---
import siteConfig from '../data/site-config'
import AnimatedSignature from './AnimatedSignature.astro'
import NavLink from './NavLink.astro'
import Search from './Search.astro'
import ThemeToggle from './ThemeToggle.astro'

const navLinks = siteConfig.headerNavLinks || [];
---

<nav class="nav min-h-12 py-2 mb-10 lg:mb-20 sm:min-h-14 backdrop-blur-sm bg-gray-300/30 dark:bg-gray-800/30 w-full">
    {
            navLinks.length > 0 && (
            <div class="w-full max-w-[674px] mx-auto relative px-4 md:px-0">
                <div class="flex items-center justify-between w-full">
                    <div class="flex items-center">
                        <button
                          class="menu-toggle w-8 h-8 flex items-center justify-center relative z-30 md:hidden mr-3"
                          aria-label="Open Menu"
                          aria-expanded="false"
                          aria-controls="menu-items"
                        >
                            <span class="menu-toggle-icon w-6 h-px relative bg-current" />
                        </button>

                        <ul id="menu-items" class="menu flex items-center gap-6">
                            <a href="/">
                            <AnimatedSignature
                              width="117px"
                              height="51px"
                              animationDuration="18s"
                              // strokeColor="#bb3a46"
                              // fillColor="#bb3a46"
                              strokeColor="#425bc5"
                              fillColor="#425bc5"
                              strokeWidth={12}
                              delayInterval={0.2}
                            />
                            </a>
                            {navLinks.map(link => (
                                <li class="py-1">
                                    <NavLink
                                      class="text-xl font-serif text-main md:text-[18px]"
                                      href={link.href}
                                    >
                                        {link.text}
                                    </NavLink>
                                </li>
                            ))}
                        </ul>
                    </div>

                    <div class="flex items-center gap-2">
                        <div class="w-8 h-8"><Search /></div>
                        <div class="w-8 h-8"><ThemeToggle /></div>
                    </div>
                </div>
            </div>
        )
    }
</nav>

<style lang="scss">
    @media (max-width: 767px) {
        /* 移动端菜单 */
        .menu {
            @apply flex-col gap-1 absolute top-12 left-4 right-4 max-w-64 px-3 pt-6 pb-10 bg-main border border-dashed border-main invisible opacity-0;
            width: calc(100vw - 2rem);
            margin-left: 0;
            z-index: 20;
        }
        .menu.is-visible {
            @apply visible opacity-100;
            transition: opacity 0.25s cubic-bezier(0.4, 0, 0.2, 1) 0.2s;
        }
        .menu-toggle-icon {
            transition: width 0.1s cubic-bezier(0.4, 0, 0.2, 1) 0.3s;
        }
        .menu-toggle.is-active .menu-toggle-icon {
            @apply w-0;
            transition: width 0.1s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .menu-toggle-icon:before,
        .menu-toggle-icon:after {
            @apply w-6 h-px absolute left-1/2 top-0 origin-center -translate-x-1/2 bg-current;
            content: '';
            transition:
                transform 0.2s cubic-bezier(0.4, 0, 0.2, 1),
                margin 0.2s cubic-bezier(0.4, 0, 0.2, 1) 0.2s;
        }
        .menu-toggle-icon:before {
            @apply -mt-1.5;
        }
        .menu-toggle-icon:after {
            @apply mt-1.5;
        }
        .menu-toggle.is-active .menu-toggle-icon:before,
        .menu-toggle.is-active .menu-toggle-icon:after {
            @apply mt-0;
            transition:
                margin 0.2s cubic-bezier(0.4, 0, 0.2, 1) 0.1s,
                transform 0.2s cubic-bezier(0.4, 0, 0.2, 1) 0.3s;
        }
        .menu-toggle.is-active .menu-toggle-icon:before {
            @apply rotate-45;
        }
        .menu-toggle.is-active .menu-toggle-icon:after {
            @apply -rotate-45;
        }
    }

    .nav {
        position: sticky;
        top: 0;
        left: 0;
        right: 0;
        z-index: 9999;
        backdrop-filter: blur(10px);

    }
</style>

<script>
// 避免重复注册事件处理器
function setupMenuToggle() {
  const menu = document.querySelector('.menu')
  const menuToggleBtn = document.querySelector('.menu-toggle')

  if (!menuToggleBtn)
    return

  // 移除之前的事件处理器，并添加正确的类型断言
  const newToggleBtn = menuToggleBtn.cloneNode(true) as HTMLButtonElement
  menuToggleBtn.parentNode?.replaceChild(newToggleBtn, menuToggleBtn)

  // 添加新的事件处理器
  newToggleBtn.addEventListener('click', () => {
    const isMenuExpanded = newToggleBtn.getAttribute('aria-expanded') === 'true'
    newToggleBtn.classList.toggle('is-active')
    newToggleBtn.setAttribute('aria-expanded', isMenuExpanded ? 'false' : 'true')
    newToggleBtn.setAttribute('aria-label', isMenuExpanded ? 'Open Menu' : 'Close Menu')
    menu?.classList.toggle('is-visible')
  })
}

// 页面加载和切换后重新初始化菜单
function initMenu() {
  setupMenuToggle()
}

// 初始化
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initMenu)
}
else {
  initMenu()
}

// Astro 页面生命周期
document.addEventListener('astro:after-swap', initMenu)
</script>
