---
import type { Locale } from '../i18n/config'
import { getSiteConfig } from '../data/site-config'
import { defaultLocale, localizedPath } from '../i18n/config'
import { useTranslations } from '../i18n/ui'
import AnimatedSignature from './AnimatedSignature.astro'
import LanguageToggle from './LanguageToggle.astro'
import NavLink from './NavLink.astro'
import Search from './Search.astro'
import ThemeToggle from './ThemeToggle.astro'

type Props = { locale?: Locale, languageUrl: string, exactLanguageMatch?: boolean }
const { locale = defaultLocale, languageUrl, exactLanguageMatch = true } = Astro.props
const t = useTranslations(locale)
const navLinks = getSiteConfig(locale).headerNavLinks || [];
---

<nav data-pagefind-ignore class="nav min-h-12 py-2 mb-10 lg:mb-20 sm:min-h-14 backdrop-blur-sm bg-gray-300/30 dark:bg-gray-800/30 w-full" aria-label={t.nav.navigation}>
    {
            navLinks.length > 0 && (
            <div class="w-full max-w-[674px] mx-auto relative px-4 md:px-0">
                <div class="flex items-center justify-between w-full">
                    <div class="flex items-center">
                        <button
                          class="menu-toggle w-9 h-9 flex items-center justify-center relative z-30 md:hidden mr-3 rounded-full hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
                          type="button"
                          aria-label={t.nav.openMenu}
                          aria-expanded="false"
                          aria-controls="menu-items"
                          data-label-open={t.nav.openMenu}
                          data-label-close={t.nav.closeMenu}
                        >
                            <span class="menu-toggle-icon w-6 h-px relative bg-current" />
                        </button>

                        <ul id="menu-items" class="menu flex items-center gap-6">
                            <li class="flex items-center"><a href={localizedPath(locale, '/')} aria-label={t.nav.home}>
                            {/* 红色 bb3a46 */}
                            <AnimatedSignature
                              width="117px"
                              height="51px"
                              animationDuration="18s"
                              strokeColor="#425bc5"
                              fillColor="#425bc5"
                              strokeWidth={12}
                              delayInterval={0.2}
                            />
                            </a></li>
                            {navLinks.map(link => (
                                <li class="nav-item py-1">
                                    <NavLink
                                      class="nav-link text-xl font-serif text-main md:text-[18px]"
                                      href={link.href}
                                    >
                                        {link.text}
                                    </NavLink>
                                </li>
                            ))}
                        </ul>
                    </div>

                    <div class="nav-actions flex items-center gap-0.5 sm:gap-1">
                        <div class="w-8 h-8"><Search locale={locale} /></div>
                        <LanguageToggle locale={locale} href={languageUrl} exactMatch={exactLanguageMatch} />
                        <div class="w-8 h-8"><ThemeToggle locale={locale} /></div>
                    </div>
                </div>
            </div>
        )
    }
</nav>

<style lang="scss">
    @reference "../styles/global.css";

    @media (max-width: 767px) {
        /* 移动端菜单 */
        .menu {
            @apply flex-col items-stretch gap-1 absolute top-12 left-4 px-2 py-2 bg-main border border-dashed border-main invisible opacity-0 rounded-xl;
            width: min(20rem, calc(100vw - 2rem));
            margin-left: 0;
            z-index: 20;
            box-shadow: var(--card-shadow);
            transform: translateY(-0.5rem) scale(0.98);
            transform-origin: top left;
            transition:
                opacity 0.18s ease,
                transform 0.18s ease,
                visibility 0s linear 0.18s;
        }
        .menu > li:first-child {
            display: none;
        }
        .menu .nav-item {
            width: 100%;
            padding: 0;
        }
        .menu .nav-link {
            display: block;
            width: 100%;
            padding: 0.55rem 0.75rem;
            border-radius: 0.5rem;
            transition: color 0.15s ease, background-color 0.15s ease;
        }
        .menu .nav-link:hover,
        .menu .nav-link:focus-visible {
            color: rgb(var(--color-primary));
            background: rgb(var(--color-text-main) / 0.07);
            outline: none;
        }
        .menu.is-visible {
            @apply visible opacity-100;
            transform: translateY(0) scale(1);
            transition:
                opacity 0.18s ease,
                transform 0.18s ease,
                visibility 0s;
        }
        .menu-toggle-icon {
            transition: width 0.1s cubic-bezier(0.4, 0, 0.2, 1) 0.3s;
        }
        .menu-toggle.is-active .menu-toggle-icon {
            @apply w-0;
            transition: width 0.1s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .menu-toggle-icon:before,
        .menu-toggle-icon:after {
            @apply w-6 h-px absolute left-1/2 top-0 origin-center -translate-x-1/2 bg-current;
            content: '';
            transition:
                transform 0.2s cubic-bezier(0.4, 0, 0.2, 1),
                margin 0.2s cubic-bezier(0.4, 0, 0.2, 1) 0.2s;
        }
        .menu-toggle-icon:before {
            @apply -mt-1.5;
        }
        .menu-toggle-icon:after {
            @apply mt-1.5;
        }
        .menu-toggle.is-active .menu-toggle-icon:before,
        .menu-toggle.is-active .menu-toggle-icon:after {
            @apply mt-0;
            transition:
                margin 0.2s cubic-bezier(0.4, 0, 0.2, 1) 0.1s,
                transform 0.2s cubic-bezier(0.4, 0, 0.2, 1) 0.3s;
        }
        .menu-toggle.is-active .menu-toggle-icon:before {
            @apply rotate-45;
        }
        .menu-toggle.is-active .menu-toggle-icon:after {
            @apply -rotate-45;
        }
    }

    .nav {
        position: sticky;
        top: 0;
        left: 0;
        right: 0;
        z-index: 9999;
        backdrop-filter: blur(10px);
    }

    .nav-actions {
        padding: 0.125rem;
        border: 1px solid rgb(var(--color-border-main) / 0.16);
        border-radius: 999px;
        background: rgb(var(--color-bg-main) / 0.5);
        box-shadow: 0 1px 2px rgb(0 0 0 / 0.04);
    }
</style>

<script>
let disposeNavigation = () => {}

function initNavigation() {
  disposeNavigation()
  const controller = new AbortController()
  const menu = document.querySelector<HTMLElement>('.menu')
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle')
  if (!menu || !toggle)
    return

  const setOpen = (isOpen: boolean) => {
    const openLabel = toggle.dataset.labelOpen ?? 'Open menu'
    const closeLabel = toggle.dataset.labelClose ?? 'Close menu'
    toggle.classList.toggle('is-active', isOpen)
    toggle.setAttribute('aria-expanded', String(isOpen))
    toggle.setAttribute('aria-label', isOpen ? closeLabel : openLabel)
    menu.classList.toggle('is-visible', isOpen)
  }

  toggle.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true')
  }, { signal: controller.signal })

  document.addEventListener('click', (event) => {
    const target = event.target
    if (
      toggle.getAttribute('aria-expanded') === 'true'
      && target instanceof Node
      && !menu.contains(target)
      && !toggle.contains(target)
    ) {
      setOpen(false)
    }
  }, { signal: controller.signal })

  menu.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setOpen(false), { signal: controller.signal })
  })

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
      setOpen(false)
      toggle.focus()
    }
  }, { signal: controller.signal })

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 768) {
      setOpen(false)
    }
  }, { signal: controller.signal })

  disposeNavigation = () => controller.abort()
}

document.addEventListener('astro:page-load', initNavigation)
document.addEventListener('astro:before-swap', () => disposeNavigation())
</script>
