---
import type { Friend } from '../data/site-config';

interface Props {
    friends: Friend[];
}

const { friends } = Astro.props;
---

<div class="-mt-32 max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-4 p-4">
    {friends.map(friend => (
        <div class="friend-card group relative overflow-hidden rounded-lg bg-[#f0f4f8]/80 dark:bg-[#1e2030]/80 backdrop-blur-md transition-all duration-300 h-[220px] md:h-[240px] flex flex-col items-center border border-gray-300/50 dark:border-gray-700/20">
            <div class="p-6 w-full flex flex-col items-center">
                {/* 头像 */}
                <div class="mb-4">
                    <img 
                        src={friend.avatar} 
                        alt={friend.name} 
                        class="w-14 h-14 md:w-16 md:h-16 rounded-full object-cover border-2 border-blue-500/30 transition-transform duration-300 group-hover:scale-105 group-hover:border-blue-500/50"
                        loading="lazy"
                    />
                </div>

                {/* 信息 */}
                <div class="w-full flex flex-col items-center flex-grow">
                    <h3 class="text-base md:text-lg font-medium text-gray-800 dark:text-gray-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                        {friend.name}
                    </h3>
                    <p class="text-sm text-gray-600 dark:text-gray-400 mt-1.5 mb-3 line-clamp-2 text-center max-w-[90%]">
                        {friend.description}
                    </p>
                    
                    {/* 标签 */}
                    <div class="flex flex-wrap justify-center gap-2 px-2">
                        {friend.tags.map(tag => (
                            <span class="inline-flex text-xs px-2 py-0.5 rounded bg-gray-200 dark:bg-[#313449] text-gray-700 dark:text-gray-300 transition-colors hover:bg-gray-300 dark:hover:bg-[#3b3f5c] whitespace-nowrap">
                                {tag}
                            </span>
                        ))}
                    </div>
                </div>

                {/* 链接 */}
                <div class="flex items-center justify-center gap-3 mt-auto pt-3 w-full border-t border-gray-300/50 dark:border-gray-700/50">
                    {friend.github && (
                        <a 
                            href={friend.github}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-gray-500 hover:text-blue-500 dark:text-gray-400 dark:hover:text-blue-400 transition-colors p-1"
                            aria-label={`Visit ${friend.name}'s GitHub profile`}
                        >
                            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                            </svg>
                        </a>
                    )}
                    {friend.link && (
                        <a 
                            href={friend.link}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-colors"
                            aria-label={`Visit ${friend.name}'s website`}
                        >
                            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                            </svg>
                        </a>
                    )}
                </div>
            </div>
        </div>
    ))}
</div>

<style lang="scss">
    .friend-card {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
        
        &::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: linear-gradient(90deg, transparent, rgba(59, 130, 246, 0.3), transparent);
            transform: translateX(-100%);
            transition: transform 0.5s ease;
        }

        &:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
            background: rgba(240, 244, 248, 0.95);
            
            &::before {
                transform: translateX(100%);
            }
            
            .dark & {
                box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
                background: rgba(30, 32, 48, 0.9);
            }
        }
    }
</style> 