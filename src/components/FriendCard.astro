---
import type { Friend } from '../data/site-config'
import type { Locale } from '../i18n/config'
import { defaultLocale } from '../i18n/config'
import FloatingCard from './FloatingCard.astro'

interface Props {
    friends: Friend[]
    locale?: Locale
}

const { friends, locale = defaultLocale } = Astro.props;

---

<h2 class="text-2xl font-bold">Friends</h2>
<div class="flex flex-col items-center gap-4">
    {friends.map(friend => (
        <div class="bg-white rounded-lg p-4 shadow-md">
            <img src={friend.avatar} alt={friend.name} class="w-8 h-8 rounded-full" />
            <h3 class="text-lg font-bold">{friend.name}</h3>
        </div>
    ))}
    <FloatingCard locale={locale} />
</div>
