---
import type { Friend } from '../data/site-config';

interface Props {
    friends: Friend[];
}

const { friends } = Astro.props;

// 预定义渐变色组合
const gradients = [
    { from: '#6366f1', to: '#818cf8' }, // 靛蓝色
    { from: '#f43f5e', to: '#fb7185' }, // 玫红色
    { from: '#f59e0b', to: '#fbbf24' }, // 琥珀色
    { from: '#0ea5e9', to: '#38bdf8' }, // 天蓝色

];

// 为每个朋友分配渐变色
const friendsWithGradients = friends.map((friend, index) => ({
    ...friend,
    gradient: gradients[index % gradients.length]
}));
---

<div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2  gap-6 p-4">
    {friendsWithGradients.map(friend => (
        <div class="friend-card group relative overflow-hidden rounded-2xl bg-white dark:bg-gray-800">
            <!-- 渐变背景 -->
            <div 
                class="card-background absolute inset-0 opacity-15 transition-all duration-300"
                style={`background: linear-gradient(135deg, ${friend.gradient.from} 0%, ${friend.gradient.to} 100%);`}
            >
            </div>
            
            <!-- 卡片内容 -->
            <div class="relative z-10 p-6">
                <!-- 头像和基本信息 -->
                <div class="flex items-start gap-4 mb-4">
                    <img 
                        src={friend.avatar} 
                        alt={friend.name} 
                        class="w-16 h-16 rounded-full object-cover border-3 border-white dark:border-gray-700 shadow-lg"
                        loading="lazy"
                    />
                    <div>
                        <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
                            {friend.name}
                        </h3>
                        <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">
                            {friend.description}
                        </p>
                    </div>
                </div>

                <!-- 标签 -->
                <div class="flex flex-wrap gap-2 mb-4">
                    {friend.tags.map(tag => (
                        <span class="tag px-3 py-1 text-sm rounded-full bg-gray-100 dark:bg-gray-700/50 text-gray-700 dark:text-gray-300">
                            {tag}
                        </span>
                    ))}
                </div>

                <!-- 链接 -->
                <div class="flex items-center gap-3 mt-auto pt-3 border-t border-gray-200 dark:border-gray-700">
                    {friend.github && (
                        <a 
                            href={friend.github}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="social-link"
                            aria-label={`Visit ${friend.name}'s GitHub profile`}
                        >
                            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                            </svg>
                        </a>
                    )}
                    {friend.link && (
                        <a 
                            href={friend.link}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="social-link"
                            aria-label={`Visit ${friend.name}'s website`}
                        >
                            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                            </svg>
                        </a>
                    )}
                </div>
            </div>
        </div>
    ))}
</div>

<style>
    .friend-card {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    }

    .friend-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
    }

    .card-background {
        clip-path: polygon(0 0, 100% 0, 100% 35%, 0 70%);
    }

    .friend-card:hover .card-background {
        opacity: 0.12;
        clip-path: polygon(0 0, 100% 0, 100% 40%, 0 75%);
    }

    .tag {
        transition: all 0.2s ease;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .tag:hover {
        background: rgba(0, 0, 0, 0.05);
    }

    :global(.dark) .tag:hover {
        background: rgba(255, 255, 255, 0.05);
    }

    .social-link {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        border-radius: 9999px;
        color: #4a5568;
        background: rgba(0, 0, 0, 0.05);
        transition: all 0.2s ease;
    }

    :global(.dark) .social-link {
        background: rgba(255, 255, 255, 0.05);
    }

    .social-link:hover {
        transform: translateY(-2px);
        color: #2d3748;
        background: rgba(0, 0, 0, 0.1);
    }

    :global(.dark) .social-link:hover {
        background: rgba(255, 255, 255, 0.1);
    }

    @media (max-width: 768px) {
        .friend-card {
            margin-bottom: 1rem;
        }
    }
</style> 