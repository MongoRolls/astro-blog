---
import type { Friend } from '../data/site-config';
import FloatingCard from './FloatingCard.astro';
interface Props {
    friends: Friend[];
}

const { friends } = Astro.props;

---

<h2 class="text-2xl font-bold">Friends</h2>
<div class="flex flex-col items-center gap-4">
    {friends.map((friend) => (
        <div class="bg-white rounded-lg p-4 shadow-md">
            <img src={friend.avatar} alt={friend.name} class="w-3 h-3 rounded-full" />
            <h3 class="text-lg font-bold">{friend.name}</h3>
        </div>
    ))}
    <FloatingCard />
</div>

<style lang="scss">

</style> 