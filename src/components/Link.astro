---
interface Props {
  href: string
  external?: boolean
  showIcon?: boolean
}

const {
  href,
  external = true,
  showIcon = true,
} = Astro.props

const children = await Astro.slots.render('default')
const rawHref = (href || '').trim()
const fallbackText = (children || '').toString().trim() || rawHref || '链接'
const normalizedHref = /^(?:[\w-]+\.)+[a-z]{2,}(?:[/:?#]|$)/i.test(rawHref)
  ? `https://${rawHref}`
  : rawHref
const isSafeHref = Boolean(normalizedHref) && !/^(?:javascript|data|vbscript):/i.test(normalizedHref)
const isExternal = /^https?:\/\//i.test(normalizedHref)
const faviconHref = isExternal
  ? `https://www.google.com/s2/favicons?domain=${new URL(normalizedHref).hostname}&sz=32`
  : ''
---

{!isSafeHref
  ? (
    <span class="link__text link__text--plain">{fallbackText}</span>
  )
  : (
    <a
      href={normalizedHref}
      class="link"
      target={external && isExternal ? '_blank' : undefined}
      rel={external && isExternal ? 'noopener noreferrer' : undefined}
    >
      {showIcon && faviconHref && (
        <img
          src={faviconHref}
          alt=""
          class="link__icon"
          loading="lazy"
          decoding="async"
          referrerpolicy="no-referrer"
          aria-hidden="true"
          onerror="this.style.display='none'"
        />
      )}
      <span class="link__text"><slot>{fallbackText}</slot></span>
    </a>
  )}

<style>
  /* 行高需与 tailwind.config.cjs 中的 p/div/li 保持一致以对齐基线 */
  .link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--link-fg, inherit);
    transition: background-color 0.15s ease;
    border-radius: 0.25rem;
    margin: 0 !important;
    line-height: 1.5;
    text-decoration: none;
    vertical-align: bottom;
    padding: 0rem 0.38rem !important;
  }

  .link:hover {
    background-color: var(--link-bg-hover, rgba(55, 53, 47, 0.08));
  }

  .link:before {content: none !important;}
  .link:after {content: none !important;}

  .link:active {
    background-color: var(--link-bg-active, rgba(55, 53, 47, 0.12));
  }

  .link__icon {
    display: block;
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    align-self: center;
    margin: 0.25rem 0 !important;
    padding: 0 !important;
    border-radius: 0.15rem;
    object-fit: contain;
  }

  .link__text {
    color: inherit;
    max-width: 200px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin: 0 !important;
    padding: 0 !important;
    line-height: 1.25;
  }

  .link__text--plain {
    display: inline-block;
  }

  /* 暗色主题适配 */
  :global([data-theme="dark"]) .link {
    color: var(--link-fg, rgba(230, 230, 227, 0.95));
  }

  :global([data-theme="dark"]) .link:hover {
    background-color: var(--link-bg-hover, rgba(255, 255, 255, 0.12));
  }

  :global([data-theme="dark"]) .link:active {
    background-color: var(--link-bg-active, rgba(255, 255, 255, 0.18));
  }
</style>
