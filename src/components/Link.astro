---
import { getFaviconCandidates, isExternalLink, normalizeUrl } from '../utils/link-metadata'

interface Props {
  href: string
  title?: string
  external?: boolean
  showIcon?: boolean
}

const { href, title, external = true, showIcon = true } = Astro.props
const normalizedHref = normalizeUrl(href?.trim())
const base = new URL(Astro.url.pathname, Astro.site ?? Astro.url)
const url = normalizedHref && URL.canParse(normalizedHref, base) ? new URL(normalizedHref, base) : null
const safe = url && !['javascript:', 'data:', 'vbscript:'].includes(url.protocol)
const externalWeb = url && /^https?:$/.test(url.protocol) && url.origin !== base.origin
const openInNewTab = external && (isExternalLink(normalizedHref) || externalWeb)
const [faviconHref, ...fallbacks] = showIcon && externalWeb ? getFaviconCandidates(url.href) : []
---

{safe
  ? (
    <a
      href={normalizedHref}
      class="link"
      target={openInNewTab ? '_blank' : undefined}
      rel={openInNewTab ? 'noopener noreferrer' : undefined}
      data-preview-description={title}
    >
      {faviconHref && (
        <img
          src={faviconHref}
          alt=""
          class="link__icon"
          loading="lazy"
          decoding="async"
          referrerpolicy="no-referrer"
          aria-hidden="true"
          data-fallbacks={fallbacks.join('|')}
          onerror="const next=(this.dataset.fallbacks||'').split('|').filter(Boolean);if(next.length){this.src=next.shift();this.dataset.fallbacks=next.join('|')}else{this.remove()}"
        />
      )}<slot>{href}</slot>
    </a>
  )
  : <span><slot>{href}</slot></span>}

<style>
  .link__icon {
    margin-inline-end: 0.25em !important;
    vertical-align: -0.14em;
  }
</style>
