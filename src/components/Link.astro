---
import type { LinkProps } from '../types/link'
import { normalizeUrl, isExternalLink, getPageTitle,getFaviconUrl } from '../utils/link-metadata'

// 组件属性
interface Props extends LinkProps {}

const {
  href,
  external = true, // 
  showIcon = true // 是否显示Icon
} = Astro.props

// 获取子内容
const children = await Astro.slots.render('default')

// 规范化URL
const normalizedUrl = normalizeUrl(href)

// 获取链接文本
const linkText = children || await getPageTitle(normalizedUrl)

// 判断是否为外部链接
const isExt = isExternalLink(normalizedUrl)

// 获取网站元数据
let siteMetadata = {
  title: linkText,
  description: `访问 ${normalizedUrl}`,
  icon: '',
  type: 'website',
  url: normalizedUrl
}

siteMetadata = {
  ...siteMetadata,
  title: linkText,
  icon: getFaviconUrl(normalizedUrl)
}

---

<a 
  href={normalizedUrl} 
  class="link"
  target={external && isExt ? '_blank' : '_self'}
  rel={external && isExt ? 'noopener noreferrer' : ''}
>
  {showIcon && siteMetadata.icon && (
    <img 
      src={siteMetadata.icon} 
      alt={`${siteMetadata.title} icon`}
      class="link__icon"
      loading="lazy"
      onerror="this.style.display='none'"
    />
  )}
  <span class="link__text">{linkText}</span>
</a>

<style>
  .link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: inherit;
    transition: background-color 0.15s ease;
    border-radius: 0.25rem;
    padding: 0.125rem 0.25rem;
    margin: 0;
    line-height: 1.5;
    text-decoration: none;
    vertical-align: baseline;
    margin: 0 !important;
    padding: 0 !important;
  }

  .link:hover {
    background-color: rgba(55, 53, 47, 0.08);
  }

  .link:before {content: none !important;}
  .link:after {content: none !important;}

  .link:active {
    background-color: rgba(55, 53, 47, 0.12);
  }

  .link__icon {
    width: 1rem;
    height: 1rem;
    border-radius: 0.15rem;
    flex-shrink: 0;
    margin: 0 !important;
    padding: 0 !important;
    object-fit: contain;
  }

  .link__text {
    color: inherit;
    max-width: 200px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin: 0 !important;
    padding: 0 !important;
    line-height: inherit;
  }

  /* 暗色主题适配 */
  :global([data-theme="dark"]) .link {
    color: inherit;
  }

  :global([data-theme="dark"]) .link:hover {
    background-color: rgba(55, 53, 47, 0.12);
  }
</style>
