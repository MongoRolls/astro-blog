---
import type { LinkProps } from '../types/link'
import {
  getFaviconUrl,
  getPageTitle,
  isExternalLink,
  isValidUrl,
  normalizeUrl,
} from '../utils/link-metadata'

interface Props extends LinkProps {}

const {
  href,
  external = true,
  showIcon = true,
} = Astro.props as Props

const children = await Astro.slots.render('default')
const rawHref = (href || '').trim()
const normalizedUrl = rawHref ? normalizeUrl(rawHref) : ''
const isUrlValid = normalizedUrl ? isValidUrl(normalizedUrl) : false

const fallbackText = (children || '').toString().trim() || rawHref || '链接'
let linkText = fallbackText

if (!children && isUrlValid) {
  const title = await getPageTitle(normalizedUrl)
  linkText = title || fallbackText
}

const isExt = isUrlValid ? isExternalLink(normalizedUrl) : false
const iconUrl = isUrlValid ? getFaviconUrl(normalizedUrl) : ''

const siteMetadata = {
  title: linkText,
  description: normalizedUrl ? `访问 ${normalizedUrl}` : linkText,
  icon: iconUrl,
  type: 'website',
  url: normalizedUrl,
}
---

{!isUrlValid
  ? (
    <span class="link__text link__text--plain">{fallbackText}</span>
  )
  : (
    <a
      href={normalizedUrl}
      class="link"
      target={external && isExt ? '_blank' : '_self'}
      rel={external && isExt ? 'noopener noreferrer' : ''}
      aria-label={`打开 ${siteMetadata.title}${normalizedUrl ? ` (${normalizedUrl})` : ''}`}
      title={siteMetadata.title}
    >
      {showIcon && siteMetadata.icon && (
        <img
          src={siteMetadata.icon}
          alt={`${siteMetadata.title} icon`}
          class="link__icon"
          loading="lazy"
          decoding="async"
          referrerpolicy="no-referrer"
          onerror="this.style.display='none'"
        />
      )}
      <span class="link__text">{linkText}</span>
    </a>
  )}

<style>
  /* 行高需与 tailwind.config.cjs 中的 p/div/li 保持一致以对齐基线 */
  .link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--link-fg, inherit);
    transition: background-color 0.15s ease;
    border-radius: 0.25rem;
    margin: 0 !important;
    line-height: 1.5;
    text-decoration: none;
    vertical-align: bottom;
    padding: 0rem 0.38rem !important;
  }

  .link:hover {
    background-color: var(--link-bg-hover, rgba(55, 53, 47, 0.08));
  }

  .link:before {content: none !important;}
  .link:after {content: none !important;}

  .link:active {
    background-color: var(--link-bg-active, rgba(55, 53, 47, 0.12));
  }

  .link__icon {
    width: 1rem;
    height: 1rem;
    border-radius: 0.15rem;
    flex-shrink: 0;
    margin: 0.25rem 0 !important;
    padding: 0 !important;
    object-fit: contain;
    display: block;
    align-self: center;
  }

  .link__text {
    color: inherit;
    max-width: 200px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin: 0 !important;
    padding: 0 !important;
    line-height: 1.25;
  }

  .link__text--plain {
    display: inline-block;
  }

  /* 暗色主题适配 */
  :global([data-theme="dark"]) .link {
    color: var(--link-fg, rgba(230, 230, 227, 0.95));
  }

  :global([data-theme="dark"]) .link:hover {
    background-color: var(--link-bg-hover, rgba(255, 255, 255, 0.12));
  }

  :global([data-theme="dark"]) .link:active {
    background-color: var(--link-bg-active, rgba(255, 255, 255, 0.18));
  }
</style>
