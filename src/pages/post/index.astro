---
import type { Locale } from '../../i18n/config'
import FormattedDate from '../../components/FormattedDate.astro'
import { defaultLocale } from '../../i18n/config'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getPostUrl, getPublishedBlogPosts } from '../../utils/data-utils'

type Props = { locale?: Locale }
const { locale = defaultLocale } = Astro.props
const sortedBlogPosts = await getPublishedBlogPosts(locale)
---

<BaseLayout
  locale={locale}
  title={locale === 'zh-CN' ? '文章列表' : 'All Posts'}
  description={locale === 'zh-CN' ? '按时间排列的全部博文，记录知识与思考沿途碰撞的痕迹。' : 'All posts in chronological order, documenting discoveries in technology and thought.'}
>
    <h1 class="text-xl text-center leading-tight font-serif font-bold sm:text-3xl mb-3">Posts</h1>

    <h2 class="text-lg text-center leading-tight font-serif font-medium sm:text-xl my-8">
        {locale === 'zh-CN' ? '记录知识与思考沿途碰撞的痕迹' : 'Notes from the intersection of knowledge and thought'}
    </h2>
    <div class="archive-list mx-auto max-w-2xl">
        {sortedBlogPosts.map((post) => {
            return (
                <div class="archive-row">
                    <span class="archive-date font-serif"><FormattedDate format="iso" date={post.data.publishDate} locale={locale} /></span>
                    <a class="post-link" href={getPostUrl(post)}><span class="post-link-text">{post.data.title}</span></a>
                </div>
            )
        })}
    </div>
  </BaseLayout>

<style>
    .archive-list {
        display: grid;
        gap: 1rem;
    }

    .archive-row {
        display: grid;
        grid-template-columns: 8rem minmax(0, 1fr);
        align-items: baseline;
        line-height: 1.65;
    }

    .archive-date {
        white-space: nowrap;
    }

    @media (max-width: 767px) {
        .archive-row {
            grid-template-columns: minmax(0, 1fr);
            gap: 0.25rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid rgb(var(--color-border-main) / 0.12);
        }

        .archive-date {
            font-size: 0.875rem;
            color: rgb(var(--color-text-muted));
        }
    }
</style>
