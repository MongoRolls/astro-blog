---
import type { CollectionEntry } from 'astro:content'
import { render } from 'astro:content'
import Button from '../../components/Button.astro'
import FormattedDate from '../../components/FormattedDate.astro'
import Link from '../../components/Link.astro'
import MyComment from '../../components/MyComment.astro'
import PostPreview from '../../components/PostPreview.astro'
import { getPostCoverSrc } from '../../config/image'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { slugify } from '../../utils/common-utils'
import { getPublishedBlogPosts } from '../../utils/data-utils'

export async function getStaticPaths() {
    const posts = await getPublishedBlogPosts()
    const postCount = posts.length

    return posts.map((post, index) => ({
        params: { id: post.id },
        props: {
            post,
            prevPost: index + 1 !== postCount ? posts[index + 1] : null,
            nextPost: index !== 0 ? posts[index - 1] : null,
        },
    }))
}

type Props = {
  post: CollectionEntry<'blog'>
  prevPost: CollectionEntry<'blog'> | null
  nextPost: CollectionEntry<'blog'> | null
}

// const { href } = Astro.url
const { post, prevPost, nextPost } = Astro.props
const { title, publishDate, updatedDate, excerpt, description, image, tags = [], keywords = [], seo, author } = post.data
const summary = seo?.description ?? excerpt ?? description
const coverImage = seo?.image ?? (image ? { src: image, alt: title } : undefined)
const { Content, headings, remarkPluginFrontmatter } = await render(post)
const { minutesRead } = remarkPluginFrontmatter;
---

<BaseLayout title={seo?.title ?? title} description={summary} image={coverImage} pageType="article" keywords={keywords} author={author} publishDate={publishDate} updatedDate={updatedDate} tags={tags} headings={headings}>
    <div class="relative lg:flex lg:gap-10">
        <!-- 主要内容 -->
        <article data-pagefind-body class="w-full lg:max-w-[674px]">
            <header class="mb-8">
                <img src={getPostCoverSrc(post.data)} alt={coverImage?.alt ?? `${title} - MongoRolls技术博客文章封面`} class="w-full h-auto rounded-lg mb-3" width="1200" height="630" loading="eager" fetchpriority="high" decoding="async" />
                <h1 data-pagefind-meta="title" class="text-3xl leading-tight font-serif text-[#425bc5] font-medium sm:text-5xl sm:leading-tight">{title}</h1>
                <div class="mt-4 text-sm">
                    <div class="text-base">published: <FormattedDate date={publishDate} /></div>
                    {
                        updatedDate && (
                            <>
                                {' '}
                                <span>
                                    (Updated on <FormattedDate date={updatedDate} />)
                                </span>
                            </>
                        )
                    }
                    <div class="text-gray-500 text-base">author: {author}</div>
                    <div class="text-gray-500 text-base">minutesRead: {minutesRead}</div>
                </div>
                <div class="w-full h-[1px] bg-gray-400 my-4" />
            </header>

            <div class="max-w-none prose  dark:prose-invert">
                <Content components={{ Link }} />
            </div>

            <div class="mt-8 flex flex-wrap items-center gap-6 text-sm justify-between sm:mt-12 sm:text-base border-y border-gray-200 py-4">
                {
                    tags.length > 0 && (
                        <div class="flex flex-wrap gap-x-5 gap-y-1 text-sm">
                            {tags.map((tag: string) => (
                                <a class="text-main text-lg hover:underline" href={`/tags/${slugify(tag)}`}>
                                    # {tag}
                                </a>
                            ))}
                        </div>
                    )
                }
                <Button
                  class="copy-url-button"
                  aria-label="Copy link"
                  data-url={Astro.url.href}
                  data-tooltip-default="Copy link"
                  data-tooltip-success="Copied"
                >
                    Share
                </Button>
            </div>
        </article>
    </div>

    {
        (prevPost || nextPost) && (
            <div data-pagefind-ignore class="my-16 sm:my-24">
                <h2 class="mb-10 text-2xl font-serif italic md:mb-12 md:text-3xl">Read More</h2>

                <div class="flex flex-col gap-10 sm:gap-12">
                    {prevPost && <PostPreview post={prevPost} headingLevel="h3" />}
                    {nextPost && <PostPreview post={nextPost} headingLevel="h3" />}
                </div>
            </div>
        )
    }

    <div data-pagefind-ignore><MyComment /></div>
</BaseLayout>


<script>
  let disposeShareButton = () => {}

  document.addEventListener('astro:page-load', () => {
    disposeShareButton()
    const controller = new AbortController()
    let resetTimer: number | undefined
    const copyUrlButton = document.querySelector('.copy-url-button') as HTMLButtonElement
    copyUrlButton?.addEventListener('click', async () => {
      await copyUrl(copyUrlButton)
    }, { signal: controller.signal })

    async function copyUrl(button: HTMLButtonElement) {
      const url = button.getAttribute('data-url') || ''
      const label = button.textContent
      try {
        await navigator.clipboard.writeText(url)
        button.textContent = 'Copied'
      }
      catch {
        button.textContent = 'Copy failed'
      }

      resetTimer = window.setTimeout(() => {
        button.textContent = label
      }, 2500)
    }

    disposeShareButton = () => {
      controller.abort()
      if (resetTimer)
        window.clearTimeout(resetTimer)
    }
  })

  document.addEventListener('astro:before-swap', () => disposeShareButton())
</script>
