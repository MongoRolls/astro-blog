---
import FriendCard from '../../components/FriendCard.astro'
import siteConfig from '../../data/site-config'
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="友链"
  description="MongoRolls 的朋友与推荐链接。"
>
    <section class="container mx-auto px-4 py-12" aria-labelledby="friends-title">
        <h1 id="friends-title" class="sr-only">友链</h1>
        <div class="mt-12 max-w-7xl mx-auto">
            <FriendCard friends={siteConfig.friends} />
        </div>
    </section>
</BaseLayout>
