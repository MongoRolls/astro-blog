---
import type { Locale } from '../../i18n/config'
import FriendCard from '../../components/FriendCard.astro'
import siteConfig from '../../data/site-config'
import { defaultLocale } from '../../i18n/config'
import BaseLayout from '../../layouts/BaseLayout.astro'

type Props = { locale?: Locale }
const { locale = defaultLocale } = Astro.props
---

<BaseLayout
  locale={locale}
  title={locale === 'zh-CN' ? '友链' : 'Friends'}
  description={locale === 'zh-CN' ? 'MongoRolls 的朋友与推荐链接。' : 'Friends and recommended links from MongoRolls.'}
>
    <section class="w-full mx-auto md:px-4 md:py-12" aria-labelledby="friends-title">
        <h1 id="friends-title" class="sr-only">{locale === 'zh-CN' ? '友链' : 'Friends'}</h1>
        <div class="md:mt-12 mx-auto">
            <FriendCard friends={siteConfig.friends} locale={locale} />
        </div>
    </section>
</BaseLayout>
