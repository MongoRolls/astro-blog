---
import FriendCard from '../../components/FriendCard.astro'
import siteConfig from '../../data/site-config'
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Friends"
  description="Friends and links from around the web"
  showHeader={false}
>
    <main class="container mx-auto px-4 py-12">
        <div class="mt-12 max-w-7xl mx-auto">
            <FriendCard friends={siteConfig.friends} />
        </div>
    </main>
</BaseLayout>

<style>
    .prose {
        max-width: 65ch;
    }
    .prose :global(h1) {
        @apply mb-8;
    }
    .prose :global(h2) {
        @apply mt-12 mb-4;
    }
    .prose :global(p) {
        @apply my-4;
    }
</style>
