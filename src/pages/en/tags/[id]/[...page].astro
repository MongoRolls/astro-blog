---
import type { GetStaticPathsOptions } from 'astro'
import siteConfig from '../../../../data/site-config'
import { getTagPageStaticPaths } from '../../../../utils/data-utils'
import TagPage from '../../../../views/TagPage.astro'

export function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  return getTagPageStaticPaths('en', paginate, siteConfig.postsPerPage || 4)
}

---

<TagPage {...Astro.props} locale="en" />
