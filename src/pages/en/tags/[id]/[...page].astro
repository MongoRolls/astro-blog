---
import type { GetStaticPathsOptions, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'
import siteConfig from '../../../../data/site-config'
import { getAllTags, getPostsByTag, getPublishedBlogPosts } from '../../../../utils/data-utils'
import TagPage from '../../../tags/[id]/[...page].astro'

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getPublishedBlogPosts('en')
  const tags = getAllTags(posts)

  return tags.flatMap((tag) => {
    const filteredPosts = getPostsByTag(posts, tag.id)
    return paginate(filteredPosts, {
      params: { id: tag.id },
      props: { tagName: tag.name },
      pageSize: siteConfig.postsPerPage || 4,
    })
  })
}

type Props = { page: Page<CollectionEntry<'blog'>>, tagName: string }
const { page, tagName } = Astro.props
---

<TagPage page={page} tagName={tagName} locale="en" />
