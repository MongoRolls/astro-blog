---
import type { GetStaticPathsOptions } from 'astro'
import siteConfig from '../../../data/site-config'
import { getBlogArchiveStaticPaths } from '../../../utils/data-utils'
import BlogArchivePage from '../../../views/BlogArchivePage.astro'

export function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  return getBlogArchiveStaticPaths('en', paginate, siteConfig.postsPerPage || 6)
}

---

<BlogArchivePage {...Astro.props} locale="en" />
