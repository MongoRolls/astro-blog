---
import type { GetStaticPathsOptions, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'
import siteConfig from '../../../data/site-config'
import { getPublishedBlogPosts } from '../../../utils/data-utils'
import BlogArchivePage from '../../blog/[...page].astro'

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getPublishedBlogPosts('en')
  return paginate(posts, { pageSize: siteConfig.postsPerPage || 6 })
}

type Props = { page: Page<CollectionEntry<'blog'>> }
const { page } = Astro.props
---

<BlogArchivePage page={page} locale="en" />
