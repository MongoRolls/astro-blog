---
import type { CollectionEntry } from 'astro:content'
import { getPageSlug, getPublishedPages } from '../../utils/data-utils'
import ContentPage from '../[...id].astro'

export async function getStaticPaths() {
  const pages = await getPublishedPages('en')
  return pages.map(page => ({
    params: { id: getPageSlug(page) },
    props: { page },
  }))
}

type Props = { page: CollectionEntry<'pages'> }
const { page } = Astro.props
---

<ContentPage page={page} locale="en" />
