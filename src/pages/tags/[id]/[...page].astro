---
import type { GetStaticPathsOptions, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'
import type { Locale } from '../../../i18n/config'
import Pagination from '../../../components/Pagination.astro'
import PostPreview from '../../../components/PostPreview.astro'
import siteConfig from '../../../data/site-config'
import { alternateLocale, defaultLocale, localizedPath, stripLocalePrefix } from '../../../i18n/config'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { getPostsByTag, getPublishedBlogPosts, getTagPageStaticPaths } from '../../../utils/data-utils'

export function getStaticPaths({ paginate }: GetStaticPathsOptions) {
    return getTagPageStaticPaths(defaultLocale, paginate, siteConfig.postsPerPage || 4)
}

type Props = { page: Page<CollectionEntry<'blog'>>, tagName: string, locale?: Locale }

const { page, tagName, locale = defaultLocale } = Astro.props
const blog = page.data
const targetLocale = alternateLocale(locale)
const tagId = Astro.params.id ?? ''
const targetPosts = getPostsByTag(await getPublishedBlogPosts(targetLocale), tagId)
const targetLastPage = Math.ceil(targetPosts.length / (siteConfig.postsPerPage || 4))
const alternateUrls = {
    [locale]: page.url.current,
    ...(targetLastPage > 0 && page.currentPage <= targetLastPage
        ? { [targetLocale]: localizedPath(targetLocale, `${stripLocalePrefix(page.url.current).replace(/\/$/, '')}/`) }
        : {}),
}
---

<BaseLayout
  locale={locale}
  alternateUrls={alternateUrls}
  languageFallbackPath="/tags/"
  title={page.currentPage > 1 ? (locale === 'zh-CN' ? `${tagName} · 第 ${page.currentPage} 页` : `${tagName} · Page ${page.currentPage}`) : tagName}
  description={locale === 'zh-CN' ? `标签「${tagName}」下的博客文章。` : `Blog posts tagged “${tagName}”.`}
  prevUrl={page.url.prev}
  nextUrl={page.url.next}
>
    <h1 class="mb-12 text-2xl leading-tight font-serif italic sm:mb-16 sm:text-4xl">Posts Tagged "{tagName}"</h1>

    <div class="flex flex-col gap-10 sm:gap-12">
        {blog.map(post => (
            <PostPreview post={post} locale={locale} />
        ))}
    </div>

    <Pagination page={page} locale={locale} class="my-16 sm:my-24" />
</BaseLayout>
