---
import type { GetStaticPathsOptions, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'
import Pagination from '../../../components/Pagination.astro'
import PostPreview from '../../../components/PostPreview.astro'
import siteConfig from '../../../data/site-config'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { getAllTags, getPostsByTag, getPublishedBlogPosts } from '../../../utils/data-utils'

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
    const posts = await getPublishedBlogPosts()
    const tags = getAllTags(posts)

    return tags.flatMap((tag) => {
        const filteredPosts = getPostsByTag(posts, tag.id)
        return paginate(filteredPosts, {
            params: { id: tag.id },
            props: { tagName: tag.name },
            pageSize: siteConfig.postsPerPage || 4,
        })
    })
}

type Props = { page: Page<CollectionEntry<'blog'>>, tagName: string }

const { page, tagName } = Astro.props
const blog = page.data
---

<BaseLayout
  title={page.currentPage > 1 ? `${tagName} · 第 ${page.currentPage} 页` : tagName}
  description={`标签「${tagName}」下的博客文章。`}
  prevUrl={page.url.prev}
  nextUrl={page.url.next}
>
    <h1 class="mb-12 text-2xl leading-tight font-serif italic sm:mb-16 sm:text-4xl">Posts Tagged "{tagName}"</h1>

    <div class="flex flex-col gap-10 sm:gap-12">
        {blog.map(post => (
            <PostPreview post={post} />
        ))}
    </div>

    <Pagination page={page} class="my-16 sm:my-24" />
</BaseLayout>
