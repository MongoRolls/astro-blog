<html lang="zh">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>流动特效</title>
</head>
<body>
    <div class="container">
        <!-- 流动的波浪背景 -->
        <div class="wave-container">
            <div class="wave wave1"></div>
            <div class="wave wave2"></div>
            <div class="wave wave3"></div>
        </div>
        
        <!-- 漂浮的粒子 -->
        <div class="particles">
            <div class="particle particle1"></div>
            <div class="particle particle2"></div>
            <div class="particle particle3"></div>
            <div class="particle particle4"></div>
            <div class="particle particle5"></div>
            <div class="particle particle6"></div>
        </div>
        
        <!-- 渐变光晕 -->
        <div class="glow glow1"></div>
        <div class="glow glow2"></div>
        <div class="glow glow3"></div>
    </div>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            overflow: hidden;
            background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
            height: 100vh;
        }

        .container {
            position: relative;
            width: 100%;
            height: 100vh;
        }

        /* 波浪动画 */
        .wave-container {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
        }

        .wave {
            position: absolute;
            top: 0;
            left: -100%;
            width: 200%;
            height: 100%;
            background: linear-gradient(90deg, 
                transparent, 
                rgba(255, 255, 255, 0.1), 
                transparent
            );
            animation: flow 8s ease-in-out infinite;
        }

        .wave1 {
            animation-delay: 0s;
            animation-duration: 6s;
        }

        .wave2 {
            animation-delay: 2s;
            animation-duration: 8s;
            background: linear-gradient(90deg, 
                transparent, 
                rgba(255, 255, 255, 0.05), 
                transparent
            );
        }

        .wave3 {
            animation-delay: 4s;
            animation-duration: 10s;
            background: linear-gradient(90deg, 
                transparent, 
                rgba(255, 255, 255, 0.08), 
                transparent
            );
        }

        @keyframes flow {
            0% {
                transform: translateX(-100%) skewX(-15deg);
            }
            50% {
                transform: translateX(0%) skewX(0deg);
            }
            100% {
                transform: translateX(100%) skewX(15deg);
            }
        }

        /* 粒子动画 */
        .particles {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
        }

        .particle {
            position: absolute;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.6);
            animation: float 12s ease-in-out infinite;
        }

        .particle1 {
            width: 4px;
            height: 4px;
            top: 20%;
            left: 10%;
            animation-delay: 0s;
            animation-duration: 8s;
        }

        .particle2 {
            width: 6px;
            height: 6px;
            top: 60%;
            left: 80%;
            animation-delay: 2s;
            animation-duration: 12s;
        }

        .particle3 {
            width: 3px;
            height: 3px;
            top: 80%;
            left: 20%;
            animation-delay: 4s;
            animation-duration: 10s;
        }

        .particle4 {
            width: 5px;
            height: 5px;
            top: 30%;
            left: 70%;
            animation-delay: 6s;
            animation-duration: 14s;
        }

        .particle5 {
            width: 2px;
            height: 2px;
            top: 50%;
            left: 40%;
            animation-delay: 8s;
            animation-duration: 9s;
        }

        .particle6 {
            width: 4px;
            height: 4px;
            top: 10%;
            left: 60%;
            animation-delay: 10s;
            animation-duration: 11s;
        }

        @keyframes float {
            0%, 100% {
                transform: translateY(0px) translateX(0px) scale(1);
                opacity: 0.7;
            }
            25% {
                transform: translateY(-20px) translateX(10px) scale(1.1);
                opacity: 1;
            }
            50% {
                transform: translateY(0px) translateX(20px) scale(0.9);
                opacity: 0.8;
            }
            75% {
                transform: translateY(20px) translateX(10px) scale(1.05);
                opacity: 0.9;
            }
        }

        /* 渐变光晕 */
        .glow {
            position: absolute;
            border-radius: 50%;
            filter: blur(40px);
            animation: pulse 6s ease-in-out infinite;
        }

        .glow1 {
            width: 200px;
            height: 200px;
            top: 20%;
            left: 20%;
            background: radial-gradient(circle, rgba(59, 130, 246, 0.4) 0%, transparent 70%);
            animation-delay: 0s;
        }

        .glow2 {
            width: 300px;
            height: 300px;
            top: 60%;
            right: 20%;
            background: radial-gradient(circle, rgba(96, 165, 250, 0.3) 0%, transparent 70%);
            animation-delay: 2s;
        }

        .glow3 {
            width: 150px;
            height: 150px;
            bottom: 20%;
            left: 50%;
            background: radial-gradient(circle, rgba(14, 165, 233, 0.4) 0%, transparent 70%);
            animation-delay: 4s;
        }

        @keyframes pulse {
            0%, 100% {
                transform: scale(1) rotate(0deg);
                opacity: 0.6;
            }
            50% {
                transform: scale(1.2) rotate(180deg);
                opacity: 0.8;
            }
        }

        /* 添加一些额外的流动效果 */
        .container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(45deg, 
                transparent 30%, 
                rgba(255, 255, 255, 0.02) 50%, 
                transparent 70%
            );
            animation: sweep 15s linear infinite;
        }

        @keyframes sweep {
            0% {
                transform: translateX(-100%) translateY(-100%);
            }
            100% {
                transform: translateX(100%) translateY(100%);
            }
        }

        /* 响应式设计 */
        @media (max-width: 768px) {
            .glow {
                filter: blur(20px);
            }
            
            .glow1, .glow2, .glow3 {
                width: 100px;
                height: 100px;
            }
            
            .particle {
                width: 3px !important;
                height: 3px !important;
            }
        }
    </style>
</body>
</html>


