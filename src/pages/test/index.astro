---
import 'tailwindcss/tailwind.css';
---


<div class="flex flex-col justify-center items-center w-[100vw] h-[100vh] gap-4">
  <input type="file" id="input" accept=".zip,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx" class="border border-gray-300 rounded-md p-2" />

  <a id="downloadLink" class="hidden px-4 py-2 bg-blue-500 hover:bg-blue-600 text-white rounded-md transition-colors flex items-center gap-2" download>
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
    </svg>
    <span id="fileName">download</span>
  </a>
  
  <p id="instruction" class="text-gray-500">select file</p>
</div>

<script>
  const input = document.getElementById('input');
  const downloadLink = document.getElementById('downloadLink');
  const fileName = document.getElementById('fileName');
  const instruction = document.getElementById('instruction');
  
  if (input && downloadLink && fileName && instruction) {
    input.addEventListener('change', (e) => {
      // @ts-ignore
      const file = e?.target?.files?.[0];
      
      if (file) {
        const blob = new Blob([file], { type: file.type });
        const url = URL.createObjectURL(blob);
        
        // 设置下载链接
        // @ts-ignore
        downloadLink.href = url;
        // @ts-ignore
        downloadLink.download = file.name;
        
        // 显示文件名
        fileName.textContent = `下载 ${file.name}`;
        
        // 显示下载按钮，隐藏提示文字
        downloadLink.classList.remove('hidden');
        instruction.classList.add('hidden');
      }
    });
    
    // 清理资源
    downloadLink.addEventListener('click', () => {
      setTimeout(() => {
        // @ts-ignore
        URL.revokeObjectURL(downloadLink.href);
      }, 100);
    });
  }
</script>