---
import type { Locale } from '../i18n/config'
import Button from '../components/Button.astro'
import FormattedDate from '../components/FormattedDate.astro'
import { defaultLocale, localizedPath } from '../i18n/config'
import BaseLayout from '../layouts/BaseLayout.astro'
import { getPostUrl, getPublishedBlogPosts } from '../utils/data-utils'

type Props = { locale?: Locale }
const { locale = defaultLocale } = Astro.props
const posts = (await getPublishedBlogPosts(locale)).slice(0, 6)
const alternateUrls = {
  'zh-CN': '/404.html',
  'en': '/en/404/',
}
---

<BaseLayout
  locale={locale}
  alternateUrls={alternateUrls}
  title={locale === 'zh-CN' ? '页面未找到' : 'Page Not Found'}
  description={locale === 'zh-CN' ? '你访问的页面不存在，可以搜索文章、查看最近更新，或返回首页。' : 'The page does not exist. Search the blog, browse recent posts, or return home.'}
  robots="noindex, follow"
>
  <section class="pb-16 sm:pb-24">
    <p class="font-serif italic text-gray-500">404</p>
    <h1 class="mt-2 mb-4 text-3xl leading-tight font-serif font-medium sm:text-5xl">{locale === 'zh-CN' ? '页面未找到' : 'Page not found'}</h1>
    <p class="mb-8 text-gray-500">
      {locale === 'zh-CN' ? '链接可能已失效，或页面从未存在。可以搜索站内文章，或从最近更新继续阅读。' : 'The link may be outdated, or the page may never have existed. Try searching or continue with a recent post.'}
    </p>
    <div class="mb-12 flex flex-wrap gap-3">
      <Button type="button" data-open-search>{locale === 'zh-CN' ? '搜索文章' : 'Search posts'}</Button>
      <Button href={localizedPath(locale, '/')}>{locale === 'zh-CN' ? '返回首页' : 'Back to home'}</Button>
    </div>

    {
      posts.length > 0 && (
        <>
          <h2 class="mb-6 text-xl font-serif font-medium sm:text-2xl">{locale === 'zh-CN' ? '最近文章' : 'Recent posts'}</h2>
          <div class="flex flex-col space-y-4">
            {posts.map(post => (
              <div>
                <span class="pr-5 font-serif inline-block w-32 text-gray-500">
                  <FormattedDate format="iso" date={post.data.publishDate} locale={locale} />
                </span>
                <a class="post-link" href={getPostUrl(post)}><span class="post-link-text">{post.data.title}</span></a>
              </div>
            ))}
          </div>
        </>
      )
    }
  </section>
</BaseLayout>
