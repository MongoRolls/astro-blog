    "oss:sync": "node scripts/oss-sync.mjs",
    "oss:sync:dry": "node scripts/oss-sync.mjs --dry-run",
    "test:browser": "playwright test",
    "test:dependencies": "node scripts/check-dependencies.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/rss": "^4.0.19",
