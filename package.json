{
  "name": "astro-blog",
  "type": "module",
  "version": "0.1.3",
  "packageManager": "pnpm@10.13.1",
  "description": "",
  "author": "MongoRolls",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:smoke": "node scripts/check-dist.mjs && node --test scripts/link-images.test.mjs",
    "verify": "pnpm lint && pnpm check && pnpm build && pnpm test:smoke && pnpm test:browser",
    "oss:sync": "node scripts/oss-sync.mjs",
    "oss:sync:dry": "node scripts/oss-sync.mjs --dry-run",
    "link:image": "node scripts/prepare-link-images.mjs",
    "cover:prepare": "node scripts/prepare-cover.mjs",
    "cover:audit": "node scripts/audit-covers.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.10",
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.6",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/fira-code": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "mdast-util-to-string": "^4.0.0",
    "pagefind": "^1.6.0",
    "remark-github-blockquote-alert": "^2.1.1",
    "sharp": "^0.35.5",
