    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/fira-code": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "mdast-util-to-string": "^4.0.0",
    "pagefind": "^1.5.2",
    "reading-time": "^1.5.0",
    "remark-github-blockquote-alert": "^2.1.0",
