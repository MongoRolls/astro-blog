    "@tailwindcss/typography": "^0.5.20",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "rollup": "^4.65.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass-embedded": "^1.105.1"
  },
  "pnpm": {
    "overrides": {
      "@tailwindcss/typography@0.5.20>postcss-selector-parser": "6.1.5",
