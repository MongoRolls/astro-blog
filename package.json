{
  "name": "astro-blog",
  "type": "module",
  "version": "0.1.3",
  "packageManager": "pnpm@10.13.1",
  "description": "",
  "author": "MongoRolls",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:smoke": "node scripts/check-dist.mjs",
