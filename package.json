    "@antfu/eslint-config": "^10.0.0",
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/typography": "^0.5.20",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.2",
    "request-filtering-agent": "^3.3.1",
    "rollup-plugin-visualizer": "^7.3.0"
  }
